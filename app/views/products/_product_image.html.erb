<div class="col-span-full md:col-span-9">
  <picture class="flex cursor-pointer items-center justify-center relative" data-lightbox-action="open">
    <%= render(ImageComponent.new(
      image: product.gallery.images.first,
      size: :product,
      itemprop: "image",
      data: { js: 'product-main-image' },
      class: 'object-contain'
    )) %>
  </picture>
</div>

<style>
  @media (min-width: 451px) {
    .img-container {
      img {
        max-height: 550px;
        max-width: 660px;
      }
    }
  }
</style>
