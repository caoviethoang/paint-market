<% if @taxon %>
  <section class="bg-[#fdf3e2] py-8 px-6 text-center border-t scroll-fade">
    <div class="flex flex-col justify-center mx-auto text-center">
      <!-- Tiêu đề -->
      <h2 class="text-h3 md:text-4xl font-bold text-gray-800 mb-3">
        <%= @taxon.name %>
      </h2>
      <div class="border-[1px] h-[2px] mx-auto w-16 w-24"></div>
      <div class="leading-relaxed mt-3 text-gray-700 text-lg">
        <p><%= @taxon.taxonomy&.description %></p>
      </div>
    </div>
  </section>
<% end %>

<div class="mx-auto px-4 sm:px-6 lg:px-8 mt-2 mb-20">
  <!-- Mobile Filter Button -->
  <div class="md:hidden mb-4">
    <button id="mobile-filter-toggle" class="flex items-center gap-2 px-4 py-2 border border-gray-300 w-full bg-white hover:bg-gray-50 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <span class="text-sm font-medium"><%= t('spree.filters.filtered_by') %></span>
    </button>
  </div>

  <!-- Modal -->
  <div id="mobile-filter-modal" class="fixed inset-0 z-50 hidden bg-black/40">
    <div id="mobile-filter-sidebar" class="top-0 h-full w-4/5 sm:w-96 bg-white shadow-lg transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
      <div class="p-4 flex justify-between items-center">
        <span class="text-sm font-medium"><%= t('spree.filters.filtered_by') %></span>
        <button id="mobile-filter-close" class="hover:bg-gray-100 rounded-full">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="p-4 flex-1 overflow-y-auto">
        <%= render 'shared/search/filters', taxon: @taxon %>
      </div>
    </div>
  </div>

  <div class="flex flex-col lg:flex-row gap-8 scroll-fade">
    <!-- Desktop Filter Sidebar -->
    <aside class="wrapper hidden md:block">
      <% if "products" == params[:controller] && @taxon %>
        <%= render 'shared/search/filters', taxon: @taxon %>
      <% else %>
        <%= render 'shared/search/filters', taxon: @taxon %>
      <% end %>
    </aside>

    <!-- Main Content -->
    <section class="flex-1">
      <% if params[:keywords] && @products.empty? %>
        <div class="text-center py-12">
          <span class="text-red-600 text-xl">
            <%= t('spree.no_products_found') %>
          </span>
        </div>
      <% else %>
        <!-- Custom Products Grid -->
        <div class="products-grid scroll-fade">
          <div class="grid grid-cols-1 md:grid-cols-2 custom-lg-grid gap-6">
            <% @products.each do |product| %>
              <% cache [I18n.locale, current_pricing_options, @taxon, product] do %>
                <%= link_to product_path(product), itemprop: 'url' do %>
                  <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden" style="cursor: pointer;">
                    <!-- Product Image -->
                    <div class="aspect-[4/3] w-full overflow-hidden bg-gray-100">
                      <% if product.gallery&.images&.any? %>
                        <%= image_tag product.gallery.images.first.attachment.url(:medium),
                          class: "w-full h-full object-cover hover:scale-105 transition-transform duration-300",
                          alt: product.name %>
                      <% else %>
                        <div class="w-full h-full flex items-center justify-center text-gray-400">
                          <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 002 2z" />
                          </svg>
                        </div>
                      <% end %>
                    </div>

                    <!-- Product Info -->
                    <div class="p-3">
                      <h3 class="font-semibold text-gray-800 hover:text-red-600 transition-colors duration-200 mb-2">
                        <span class="hover:text-red-600"> <%= product.name %></span>
                      </h3>

                      <p class="text-sm text-gray-600 mb-3">
                        <%= truncate(product.description, length: 60) %>
                      </p>

                      <div class="flex justify-between items-center">
                        <span class="font-bold text-lg text-red-600">
                          <% if product.price_for_options(current_pricing_options) %>
                            <%= product.price_for_options(current_pricing_options).money.to_html %>
                          <% end %>
                        </span>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>

        <% if @products.respond_to?(:total_pages) %>
          <%= paginate @products %>
        <% end %>
      <% end %>
    </section>
  </div>
</div>

<style>
  @media (min-width: 992px) {
    .custom-lg-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .scroll-fade {
      opacity: 0;
      transform: translateY(40px);
      transition: all 0.8s ease-out;
    }

    .scroll-fade.visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
