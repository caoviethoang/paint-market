<% @body_id = 'product-details' %>
<% @title = t('spree.product.more_work_title', artist_name: @artist.name) %>

<% cache [I18n.locale, current_pricing_options, @product] do %>
  <section itemscope itemtype="http://schema.org/Product" class="product-show lg:p-0 sm:px-6 lg:mt-4 md:container mx-auto">
    <!-- Mobile Layout: Stack vertically -->
    <div id="mobile-gallery" class="md:hidden flex flex-col lg:flex-row w-full lg:pb-12 py-4 px-4">
      <!-- Image Section -->
      <div class="w-full lg:flex-none custom-width h-full">
        <div class="flex flex-col-reverse gap-4 overflow-auto lg:h-full lg:max-h-[680px]">
          <%= render 'product_image', product: @product %>
        </div>

        <div class="flex justify-center mb-4">
          <%= render 'product_thumbnails', product: @product %>
        </div>
      </div>

      <!-- Product Details Section -->
      <div class="w-full flex flex-col">
        <%= render 'product_info', product: @product %>
        <%= render 'cart_line_items/form', product: @product %>
      </div>
    </div>

    <!-- Desktop image Layout: Stack vertically -->
    <div id="desktop-gallery" class="hidden md:block mt-8 scroll-fade">
      <div class="w-full h-full flex justify-center">
        <div class="w-full px-4 lg:px-8">
          <div class="flex gap-8 items-stretch img-container">
            <!-- Image Section -->
            <div class="flex-1 flex">
              <div class="w-full h-full">
                <%= render 'product_image', product: @product %>
              </div>
            </div>

            <!-- Product Details Section -->
            <div class="flex-1 flex flex-col justify-between">
              <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 items-center py-5">
                <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.title') %></span>

                <h1 class="text-h6 lg:text-h6" itemprop="name">
                  <%= @product.name %>
                </h1>
              </div>

              <% if @product.price_for_options(current_pricing_options)&.money && !@product.price.nil? %>
                <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 items-center py-5">
                  <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.price') %></span>

                  <h2 class="font-sans-md text-body-md" id="product-price">
                    <%= content_tag(
                      :span,
                      price_product(@product),
                      itemprop: 'price',
                      content: @product.price_for_options(current_pricing_options)&.money.to_d,
                      data: { js: 'price' }
                    ) %>

                    <%= content_tag(
                      :span,
                      price_currency,
                      itemprop: 'priceCurrency'
                    ) %>
                  </h2>
                </div>
              <% end %>

              <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 items-center py-5">
                <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.artist') %></span>
                <p class="font-sans text-body" itemprop="artist">
                  <%= @product.artist&.name %>
                </p>
              </div>

              <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 items-center py-5">
                <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.details') %></span>
                <div class="font-sans text-body" style="width: 75%;">
                  <% if @product.properties.any? %>
                    <% values = @product.properties.map do |property|
                        value = @product.property(property.name).presence
                        translated = value.present? ? I18n.t("spree.product.#{value}", default: "") : ""
                        if translated.present?
                          "#{t("spree.properties.#{property.name}", default: property.name.humanize)}: #{translated}"
                        end
                      end.compact.join(', ') %>

                    <% if values.present? %>
                      <span>
                        <%= values.html_safe %>
                      </span>
                    <% else %>
                      <%= t('spree.product.no_details') %>
                    <% end %>
                  <% else %>
                    <%= t('spree.product.no_details') %>
                  <% end %>
                </div>
              </div>

              <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 items-center py-5">
                <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.views_count') %></span>
                <p class="font-sans text-body" itemprop="views_count">
                  <%= @product.views_count %>
                </p>
              </div>

              <% if @product.votes.any? %>
                <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 items-center py-5">
                  <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.vote') %></span>
                  <p class="font-sans text-body" itemprop="vote">
                    <%= @product.average_rating %>
                    <span class="text-orange">
                      <%= "★" %>
                    </span>
                  </p>
                </div>
              <% end %>

              <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 items-center py-5">
                <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.description') %></span>
                <span class="font-sans text-body" itemprop="description" style="width: 75%;">
                  <%= product_description(@product) rescue t('spree.product_has_no_description') %>
                </span>
              </div>

              <div>
                <%= render 'cart_line_items/form', product: @product %>
              </div>
            </div>
          </div>
          <%= render 'product_thumbnails', product: @product %>
        </div>
      </div>
    </div>

    <div class="w-full h-full flex justify-center mt-28 scroll-fade">
      <div class="w-full px-4 lg:px-8">
        <div class="flex gap-8 items-stretch img-container">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div class="flex justify-center">
              <% if @artist.background_image.attached? %>
                <%= image_tag @artist.background_image_url(:large),
                  alt: @artist.name,
                  class: "cus-image-width h-auto" %>
              <% else %>
                <div class="w-full h-64 bg-gray-200 flex items-center justify-center rounded-lg">
                  <span class="text-gray-500"><%= t('spree.product.no_image') %></span>
                </div>
              <% end %>
            </div>

            <div class="space-y-4">
              <h2 class="text-h4 md:text-h2.5 font-bold text-gray-900"><%= @artist.name %></h2>
              <p class="text-base lg:text-h4 text-gray-600"><%= @artist.address %></p>
              <p class="text-gray-700 leading-relaxed lg:text-h6"><%= @artist.introduction %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 px-4 lg:px-8 scroll-fade">
      <h2 class="text-h6 font-bold mb-6">Đánh giá sản phẩm</h2>
      <% if @product.votes.any? %>
        <div class="mb-8">
          <%= render 'votes/list', votes: @product.votes.recent %>
        </div>
      <% end %>

      <%= render 'votes/form' %>
    </div>

    <div class="pt-12 scroll-fade">
      <%= render partial: 'home/collection', :locals => { :title => @title, :products => @similar_products } %>
    </div>

    <div data-lightbox-target="modal"
      data-action="click->lightbox#closeBackground"
      class="fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-[9999] hidden overflow-hidden">
      <div class="relative w-full h-full flex items-center justify-center">
        <img data-lightbox-target="image" src="" alt="Ảnh phóng to"
            class="max-w-[90%] max-h-[90%] transition-transform duration-200 cursor-move">
        <div class="absolute flex items-center justify-center right-0 text-white top-0">
          <button data-lightbox-action="zoomOut" class="p-1 hover:bg-opacity-75 rounded-r-full">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
            </svg>
          </button>
          <button data-lightbox-action="zoomIn" class="p-1 hover:bg-opacity-75 rounded-l-full">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
          </button>

          <button data-lightbox-action="close" class="p-1 hover:bg-opacity-75 rounded-l-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>
<% end %>

<style>
  .scroll-fade {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease-out;
  }

  .scroll-fade.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .cus-image-width {
    max-height: 450px !important;
  }

  @media (min-width: 451px) {
    .img-container {
      max-height: 550px;
    }

    .custom-width-row {
      width: 25%;
    }
  }

  @media (max-width: 450px) {
    .cus-image-width {
      width: 100%;
    }
  }
</style>

<script>
  (function() {
    let modal = null;
    let image = null;
    let initialScale = 1;
    let currentScale = 1;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let translateX = 0;
    let translateY = 0;

    function init() {
      modal = document.querySelector('[data-lightbox-target="modal"]');
      image = document.querySelector('[data-lightbox-target="image"]');

      if (!modal || !image) {
        console.error('Lightbox elements not found');
        return;
      }

      bindEvents();
    }

    function bindEvents() {
      const openButtons = document.querySelectorAll('[data-lightbox-action="open"]');
      openButtons.forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault();
          open(this);
        });
      });

      const closeButton = document.querySelector('[data-lightbox-action="close"]');
      if (closeButton) {
        closeButton.addEventListener('click', close);
      }

      if (modal) {
        modal.addEventListener('click', closeBackground);
      }

      const zoomInButton = document.querySelector('[data-lightbox-action="zoomIn"]');
      const zoomOutButton = document.querySelector('[data-lightbox-action="zoomOut"]');

      if (zoomInButton) {
        zoomInButton.addEventListener('click', zoomIn);
      }

      if (zoomOutButton) {
        zoomOutButton.addEventListener('click', zoomOut);
      }

      // Thêm sự kiện kéo ảnh
      if (image) {
        image.addEventListener('mousedown', startDrag);
        image.addEventListener('mousemove', drag);
        image.addEventListener('mouseup', endDrag);
        image.addEventListener('mouseleave', endDrag);
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          close();
        }
      });
    }

    function open(element) {
      const imageUrl = element.childNodes[1].src;

      if (!imageUrl || !modal || !image) return;

      image.src = imageUrl;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      currentScale = initialScale;
      translateX = 0;
      translateY = 0;
      updateTransform();
    }

    function close() {
      if (!modal || !image) return;

      modal.classList.add('hidden');
      image.src = '';
      document.body.style.overflow = 'auto';

      currentScale = initialScale;
      translateX = 0;
      translateY = 0;
      updateTransform();
    }

    function closeBackground(event) {
      if (event.target === modal) {
        close();
      }
    }

    function zoomIn() {
      if (!image) return;

      currentScale += 1.2;
      updateTransform();
    }

    function zoomOut() {
      if (!image) return;

      if (currentScale > initialScale) {
        currentScale -= 1.2;
        updateTransform();
      }
    }

    function startDrag(e) {
      if (currentScale <= initialScale) return;

      isDragging = true;
      startX = e.clientX - translateX;
      startY = e.clientY - translateY;
      image.style.cursor = 'grabbing';
      e.preventDefault();
    }

    function drag(e) {
      if (!isDragging) return;

      translateX = e.clientX - startX;
      translateY = e.clientY - startY;
      updateTransform();
    }

    function endDrag() {
      isDragging = false;
      if (image && currentScale > initialScale) {
        image.style.cursor = 'move';
      }
    }

    function updateTransform() {
      if (!image) return;

      image.style.transform = `translate(${translateX}px, ${translateY}px) scale(${currentScale})`;
      image.style.transition = isDragging ? 'none' : 'transform 0.3s ease-in-out';

      if (currentScale > initialScale) {
        image.style.cursor = 'move';
      } else {
        image.style.cursor = 'default';
        translateX = 0;
        translateY = 0;
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('turbo:load', init);
  })();
</script>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const mobileGallery = document.getElementById('mobile-gallery');
    const desktopGallery = document.getElementById('desktop-gallery');

    const activeGallery = mobileGallery && window.getComputedStyle(mobileGallery).display !== 'none'
      ? mobileGallery
      : desktopGallery;

    if (!activeGallery) {
      return;
    }

    const radios = activeGallery.querySelectorAll("[data-js='variant-radio']");
    const thumbnailsLinks = activeGallery.querySelectorAll("[data-js='product-thumbnail'] a, [data-js='variant-thumbnail'] a");
    const productImage = activeGallery.querySelector("[data-js='product-main-image']");
    const variantsThumbnails = activeGallery.querySelectorAll("[data-js='variant-thumbnail']");

    if (!productImage) {
      return;
    }

    if (radios.length > 0) {
      const selectedRadio = activeGallery.querySelector("[data-js='variant-radio'][checked='checked']");
      if (selectedRadio) {
        updateVariantPrice(selectedRadio);
        updateVariantImages(selectedRadio.value);
      }
    }

    radios.forEach(radio => {
      radio.addEventListener('click', () => {
        updateVariantPrice(radio);
        updateVariantImages(radio.value);
      });
    });

    thumbnailsLinks.forEach(thumbnailLink => {
      thumbnailLink.addEventListener('click', (event) => {
        event.preventDefault();
        updateProductImage(thumbnailLink.href);
      });
    });

    function updateVariantPrice(variant) {
      const variantPrice = variant.dataset.jsPrice;
      if (variantPrice) {
        const priceElement = activeGallery.querySelector("[data-js='price']");
        if (priceElement) {
          priceElement.innerHTML = variantPrice;
        }
      }
    }

    function updateVariantImages(variantId) {
      const selector = "[data-js='variant-thumbnail'][data-js-id='" + variantId + "']";
      const variantsThumbnailsToDisplay = activeGallery.querySelectorAll(selector);

      variantsThumbnails.forEach(thumbnail => {
        thumbnail.style.display = 'none';
      });

      variantsThumbnailsToDisplay.forEach(thumbnail => {
        thumbnail.style.display = 'list-item';
      });

      if (variantsThumbnailsToDisplay.length) {
        const variantFirstImage = variantsThumbnailsToDisplay[0].querySelector('a').href;
        updateProductImage(variantFirstImage);
      }
    }

    function updateProductImage(imageSrc) {
      productImage.src = imageSrc;
    }

  });
</script>
