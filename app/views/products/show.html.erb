<% @body_id = 'product-details' %>
<% @title = t('spree.product.more_work_title', artist_name: @artist.name) %>

<% cache [I18n.locale, current_pricing_options, @product] do %>
  <section itemscope itemtype="http://schema.org/Product" class="product-show lg:p-0 sm:px-6 lg:mt-4 border-t">
    <!-- Mobile Layout: Stack vertically -->
    <div id="mobile-gallery" class="md:hidden flex flex-col lg:flex-row w-full lg:pb-12 py-4 px-4 scroll-fade">
      <!-- Image Section -->
      <div class="w-full lg:flex-none custom-width h-full">
        <div class="flex flex-col-reverse gap-4 overflow-auto lg:h-full lg:max-h-[680px]">
          <%= render 'product_image', product: @product %>
        </div>
        <%= render 'product_thumbnails', product: @product %>
      </div>

      <!-- Product Details Section -->
      <div class="w-full flex flex-col">
        <%= render 'product_info', product: @product %>
        <%= render 'cart_line_items/form', product: @product %>
      </div>
    </div>

    <!-- Desktop image Layout: Stack vertically -->
    <div id="desktop-gallery" class="hidden md:block mt-8 scroll-fade">
      <div class="w-full h-full flex justify-center">
        <div class="w-full px-4 lg:px-8">
          <div class="flex gap-8 items-stretch img-container">
            <!-- Image Section -->
            <div class="flex-1 flex">
              <div class="w-full h-full">
                <%= render 'product_image', product: @product %>
              </div>
            </div>

            <!-- Product Details Section -->
            <div class="flex-1 flex flex-col justify-between">
              <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 py-5">
                <!-- Cột trái: Label -->
                <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.title') %></span>

                <!-- Cột phải: Value -->
                <h1 class="text-h6 lg:text-h6" itemprop="name">
                  <%= @product.name %>
                </h1>
              </div>

              <% if @product.price_for_options(current_pricing_options)&.money && !@product.price.nil? %>
                <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 py-5">
                  <!-- Label -->
                  <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.price') %></span>

                  <!-- Value -->
                  <h2 class="font-sans-md text-body-md" id="product-price">
                    <%= content_tag(
                      :span,
                      price_product(@product),
                      itemprop: 'price',
                      content: @product.price_for_options(current_pricing_options)&.money.to_d,
                      data: { js: 'price' }
                    ) %>

                    <%= content_tag(
                      :span,
                      price_currency,
                      itemprop: 'priceCurrency'
                    ) %>
                  </h2>
                </div>
              <% end %>

              <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 py-5">
                <!-- Label -->
                <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.artist') %></span>
                <!-- Value -->
                <p class="font-sans text-body" itemprop="artist">
                  <%= @product.artist.name rescue t('spree.product_has_no_name') %>
                </p>
              </div>

              <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 py-5">
                <!-- Label -->
                <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.details') %></span>
                <!-- Value -->
                <div class="font-sans text-body" style="width: 75%;">
                  <% if @product.properties.any? %>
                    <% values = @product.properties.map do |property|
                        value = @product.property(property.name).presence
                        translated = value.present? ? I18n.t("spree.product.#{value}", default: "") : ""
                        if translated.present?
                          "#{t("spree.properties.#{property.name}", default: property.name.humanize)}: #{translated}"
                        end
                      end.compact.join(', ') %>

                    <% if values.present? %>
                      <span>
                        <%= values.html_safe %>
                      </span>
                    <% else %>
                      <%= t('spree.product.no_details') %>
                    <% end %>
                  <% else %>
                    <%= t('spree.product.no_details') %>
                  <% end %>
                </div>
              </div>

              <div class="flex flex-col lg:flex-row border-t border-dashed border-gray-500 py-5">
                <!-- Label -->
                <span class="custom-width-row font-sans-sm text-gray-600"><%= t('spree.product.description') %></span>
                <!-- Value -->
                <span class="font-sans text-body" itemprop="description" style="width: 75%;">
                  <%= product_description(@product) rescue t('spree.product_has_no_description') %>
                </span>
              </div>

              <div>
                <%= render 'cart_line_items/form', product: @product %>
              </div>
            </div>
          </div>
          <%= render 'product_thumbnails', product: @product %>
        </div>
      </div>
    </div>

    <div class="w-full h-full flex justify-center mt-28 scroll-fade">
      <div class="w-full px-4 lg:px-8">
        <div class="flex gap-8 items-stretch img-container">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <!-- Cột bên trái: ảnh -->
            <div class="flex justify-center">
              <% if @artist.background_image.attached? %>
                <%= image_tag @artist.background_image_url(:large),
                  alt: @artist.name,
                  class: "cus-image-width h-auto" %>
              <% else %>
                <div class="w-full h-64 bg-gray-200 flex items-center justify-center rounded-lg">
                  <span class="text-gray-500"><%= t('spree.product.no_image') %></span>
                </div>
              <% end %>
            </div>

            <!-- Cột bên phải: thông tin -->
            <div class="space-y-4">
              <h2 class="text-2xl md:text-h2.5 font-bold text-gray-900"><%= @artist.name %></h2>
              <p class="text-base lg:text-h4 text-gray-600"><%= @artist.address %></p>
              <p class="text-gray-700 leading-relaxed lg:text-h6"><%= @artist.introduction %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="pt-12 scroll-fade">
      <%= render partial: 'home/collection', :locals => { :title => @title, :products => @similar_products } %>
    </div>
  </section>
<% end %>

<style>
  .scroll-fade {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease-out;
  }

  .scroll-fade.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .cus-image-width {
    max-height: 450px !important;
  }

  @media (min-width: 451px) {
    .img-container {
      max-height: 550px;
    }

    .custom-width-row {
      width: 25%;
    }
  }

  @media (max-width: 450px) {
    .product-show {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .cus-image-width {
      width: 100%;
    }
  }
</style>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const mobileGallery = document.getElementById('mobile-gallery');
    const desktopGallery = document.getElementById('desktop-gallery');

    const activeGallery = mobileGallery && window.getComputedStyle(mobileGallery).display !== 'none'
      ? mobileGallery
      : desktopGallery;

    if (!activeGallery) {
      return;
    }

    const radios = activeGallery.querySelectorAll("[data-js='variant-radio']");
    const thumbnailsLinks = activeGallery.querySelectorAll("[data-js='product-thumbnail'] a, [data-js='variant-thumbnail'] a");
    const productImage = activeGallery.querySelector("[data-js='product-main-image']");
    const variantsThumbnails = activeGallery.querySelectorAll("[data-js='variant-thumbnail']");

    if (!productImage) {
      return;
    }

    if (radios.length > 0) {
      const selectedRadio = activeGallery.querySelector("[data-js='variant-radio'][checked='checked']");
      if (selectedRadio) {
        updateVariantPrice(selectedRadio);
        updateVariantImages(selectedRadio.value);
      }
    }

    radios.forEach(radio => {
      radio.addEventListener('click', () => {
        updateVariantPrice(radio);
        updateVariantImages(radio.value);
      });
    });

    thumbnailsLinks.forEach(thumbnailLink => {
      thumbnailLink.addEventListener('click', (event) => {
        event.preventDefault();
        updateProductImage(thumbnailLink.href);
      });
    });

    function updateVariantPrice(variant) {
      const variantPrice = variant.dataset.jsPrice;
      if (variantPrice) {
        const priceElement = activeGallery.querySelector("[data-js='price']");
        if (priceElement) {
          priceElement.innerHTML = variantPrice;
        }
      }
    }

    function updateVariantImages(variantId) {
      const selector = "[data-js='variant-thumbnail'][data-js-id='" + variantId + "']";
      const variantsThumbnailsToDisplay = activeGallery.querySelectorAll(selector);

      variantsThumbnails.forEach(thumbnail => {
        thumbnail.style.display = 'none';
      });

      variantsThumbnailsToDisplay.forEach(thumbnail => {
        thumbnail.style.display = 'list-item';
      });

      if (variantsThumbnailsToDisplay.length) {
        const variantFirstImage = variantsThumbnailsToDisplay[0].querySelector('a').href;
        updateProductImage(variantFirstImage);
      }
    }

    function updateProductImage(imageSrc) {
      productImage.src = imageSrc;
    }

  });
</script>
