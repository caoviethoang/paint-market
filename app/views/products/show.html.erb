<% @body_id = 'product-details' %>
<% @title = t('spree.product.more_work_title', artist_name: @artist.name) %>

<% cache [I18n.locale, current_pricing_options, @product] do %>
  <section itemscope itemtype="http://schema.org/Product" class="px-4 sm:px-6">
    <!-- Mobile Layout: Stack vertically -->
    <div class="flex flex-col lg:flex-row w-full lg:pb-12 py-4 gap-6">
      <!-- Image Section -->
      <div class="w-full lg:flex-none lg:w-2/3 h-full">
        <div class="flex flex-col-reverse gap-4 overflow-auto lg:h-full lg:max-h-[680px]">
          <%= render 'product_image', product: @product %>
        </div>
        <%= render 'product_thumbnails', product: @product %>
      </div>

      <!-- Product Details Section -->
      <div class="w-full lg:flex-none lg:w-1/3 flex flex-col gap-y-6 lg:gap-y-16">
        <%= render 'product_header', product: @product %>
        <%= render 'product_info', product: @product %>
        <%= render 'product_promotions', product: @product %>
        <%= render 'cart_line_items/form', product: @product %>
      </div>
    </div>

    <div class="bg-[#fdf3e2] mt-12 p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <!-- Cột bên trái: ảnh -->
        <div>
          <% if @artist.background_image.attached? %>
            <%= image_tag @artist.background_image_url(:large),
              alt: @artist.name,
              class: "w-full h-auto rounded-lg" %>
          <% else %>
            <div class="w-full h-64 bg-gray-200 flex items-center justify-center rounded-lg">
              <span class="text-gray-500"><%= t('spree.product.no_image') %></span>
            </div>
          <% end %>
        </div>

        <!-- Cột bên phải: thông tin -->
        <div class="space-y-4">
          <h2 class="text-2xl md:text-h2.5 font-bold text-gray-900"><%= @artist.name %></h2>
          <p class="text-base md:text-lg text-gray-600"><%= @artist.address %></p>
          <p class="text-gray-700 leading-relaxed"><%= @artist.introduction %></p>
        </div>
      </div>
    </div>

    <div class="pt-12 mt-28">
      <%= render partial: 'home/collection', :locals => { :title => @title, :products => @similar_products } %>
    </div>
  </section>
<% end %>
