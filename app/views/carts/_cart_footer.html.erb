<% order = order_form.object %>

<footer class="cart-footer">
  <%= render 'carts/cart_adjustments' %>
  
  <!-- Mobile Total Section -->
  <div class="lg:hidden border-t border-gray-300 pt-4 mb-4">
    <div class="flex justify-between items-center text-lg font-bold text-gray-900">
      <span><%= t('spree.total') %>:</span>
      <span><%= order.display_total %></span>
    </div>
  </div>
  
  <!-- Desktop Total Section -->
  <p class="hidden lg:block cart-footer__total flex justify-between mb-3 text-body-20 p-2">
    <%= t('spree.total') %>: <span class="font-sans-md"><%= order.display_total %></span>
  </p>
  
  <!-- Mobile Continue Shopping Button -->
  <%= link_to t('spree.continue_shopping', default: "Continue Shopping"),
        products_path,
        class: "lg:hidden w-full py-3 px-6 bg-gray-200 text-gray-800 font-semibold rounded-lg hover:bg-gray-300 transition-colors text-center block mb-3" %>
  
  <!-- Action Buttons -->
  <div class="cart-footer__primary-action flex flex-col lg:flex-row justify-between gap-3 lg:gap-0">
    <!-- Desktop Continue Shopping Button -->
    <%= link_to t('spree.continue_shopping', default: "Continue Shopping"),
            products_path,
            class: "hidden lg:block bg-sand border p-2 rounded-full hover:bg-gray-100 hover:text-gray-900 transition" %>
    
    <!-- Checkout Button -->
    <%= order_form.button(
      I18n.t('spree.checkout'),
      class: 'w-full lg:w-auto button-primary',
      id: 'checkout-link',
      name: :checkout
    ) %>
  </div>
</footer>
