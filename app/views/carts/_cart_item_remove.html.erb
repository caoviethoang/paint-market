<!-- Desktop Remove Button -->
<svg class='hidden lg:block w-5 h-5 fill-black dark:fill-white'>
    <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-close-line"></use>
</svg>
<%= order_form.submit(
    'Remove',
    class: "underline text-body-sm cursor-pointer lg:flex lg:items-center lg:gap-1 lg:text-sm lg:text-red-600 lg:hover:text-red-800 lg:transition-colors",
    id: "delete_#{dom_id(line_item)}",
    data: { disable_with: 'Remove' },
    'data-action': 'click->cart-page#setQuantityToZero',
    # FIXME: `index: nil` is required because otherwise rails will double the index
    'data-cart-page-quantity-id-param': item_form.field_id(:quantity, index: nil),
) do %>
  <svg class='hidden lg:block w-4 h-4 fill-current'>
    <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-close-line"></use>
  </svg>
  Remove
<% end %>