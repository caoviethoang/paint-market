<%= form_with(
      model: @order,
      url: cart_path,
      method: :patch,
      data: { controller: "cart-page" }
    ) do |f| %>

  <%= f.hidden_field :id, value: @order.id %>

  <%= f.fields_for :line_items, line_item do |item_form| %>
    <%= item_form.hidden_field :id, value: line_item.id %>
    <%= item_form.hidden_field :quantity, value: (line_item.quantity - 1), id: item_form.field_id(:quantity, index: nil) %>
  <% end %>

  <%= f.submit "Remove",
      class: "underline text-body-sm cursor-pointer lg:flex lg:items-center lg:gap-1 lg:text-sm lg:text-red-600 lg:hover:text-red-800 lg:transition-colors",
      data: {
        action: "click->cart-page#setQuantityToZero",
        cart_page_quantity_id_param: "order_line_items_attributes_#{line_item.id}_quantity"
      } %>
<% end %>
