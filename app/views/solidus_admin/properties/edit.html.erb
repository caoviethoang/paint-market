<div class="bg-white shadow rounded-lg">
  <div class="px-4 py-5 sm:p-6">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Property: <%= @property.name %></h1>
      <div class="flex gap-2">
        <%= link_to "Back", properties_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded" %>
        <%= link_to "Delete", property_path(@property), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h2 class="text-lg font-semibold mb-3">Details</h2>
        <div class="space-y-3">
          <div>
            <div class="text-sm text-gray-500">Name</div>
            <div class="text-base text-gray-900"><%= @property.name %></div>
          </div>
          <div>
            <div class="text-sm text-gray-500">Presentation</div>
            <div class="text-base text-gray-900"><%= @property.presentation %></div>
          </div>
          <div>
            <div class="text-sm text-gray-500">Created</div>
            <div class="text-base text-gray-900"><%= @property.created_at.strftime('%Y-%m-%d %H:%M') %></div>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-lg font-semibold mb-3">Property Values</h2>
        <div class="space-y-2">
          <% if @property.property_values.any? %>
            <% @property.property_values.ordered.each do |v| %>
              <div class="flex items-center justify-between border rounded px-3 py-2">
                <div>
                  <div class="font-medium"><%= v.display_name %></div>
                  <div class="text-sm text-gray-500">Value: <%= v.value %> · Position: <%= v.position %></div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-gray-500">No values</div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <%= form_with model: @property, url: property_path(@property), method: :put, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        <div>
          <%= f.label :presentation, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :presentation, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        <div class="flex gap-2">
          <%= f.submit "Save", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
          <%= link_to "Cancel", properties_path, class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

