<%# Override SolidusAdmin properties show view %>

<div class="bg-white shadow rounded-lg">
  <div class="px-4 py-5 sm:p-6">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @property.name %></h1>
        <p class="text-gray-600">Presentation: <%= @property.presentation %></p>
      </div>
      <div class="flex space-x-3">
        <%= link_to "Edit Property", edit_solidus_admin_property_path(@property), 
            class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
        <%= link_to "Back to Properties", solidus_admin_properties_path, 
            class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Property Details -->
      <div class="bg-gray-50 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Property Details</h3>
        <dl class="space-y-3">
          <div>
            <dt class="text-sm font-medium text-gray-500">Name:</dt>
            <dd class="text-sm text-gray-900"><%= @property.name %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Presentation:</dt>
            <dd class="text-sm text-gray-900"><%= @property.presentation %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Created:</dt>
            <dd class="text-sm text-gray-900"><%= @property.created_at.strftime('%B %d, %Y at %I:%M %p') %></dd>
          </div>
        </dl>
      </div>

      <!-- Property Values -->
      <div class="bg-gray-50 rounded-lg p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-900">Property Values</h3>
          <button type="button" onclick="toggleAddForm()" 
                  class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded text-sm">
            Add Property Value
          </button>
        </div>

        <% property_values = PropertyValue.where(property: @property).order(:position, :display_name) %>
        <% if property_values.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-100">
                <tr>
                  <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Position</th>
                  <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Value</th>
                  <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Display Name</th>
                  <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% property_values.each do |value| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-3 py-2 whitespace-nowrap text-sm text-gray-900"><%= value.position %></td>
                    <td class="px-3 py-2 whitespace-nowrap text-sm text-gray-900"><%= value.value %></td>
                    <td class="px-3 py-2 whitespace-nowrap text-sm text-gray-900"><%= value.display_name %></td>
                    <td class="px-3 py-2 whitespace-nowrap text-sm font-medium">
                      <div class="flex space-x-2">
                        <%= link_to "Edit", edit_solidus_admin_property_property_value_path(@property, value), 
                            class: "text-blue-600 hover:text-blue-900" %>
                        <%= link_to "Delete", solidus_admin_property_property_value_path(@property, value), 
                            method: :delete, 
                            data: { confirm: 'Are you sure?' },
                            class: "text-red-600 hover:text-red-900" %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-8">
            <div class="text-gray-500 text-lg">No property values found</div>
            <div class="mt-4">
              <button type="button" onclick="toggleAddForm()" 
                      class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
                Add First Property Value
              </button>
            </div>
          </div>
        <% end %>

        <!-- Add Property Value Form -->
        <div id="addValueForm" style="display: none;" class="mt-6">
          <div class="bg-white border border-gray-200 rounded-lg p-4">
            <h4 class="text-lg font-semibold text-gray-900 mb-4">Add New Property Value</h4>
            <%= form_with model: [@property, PropertyValue.new], url: solidus_admin_property_property_values_path(@property), local: true, class: 'space-y-4' do |form| %>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <%= form.label :value, "Value", class: 'block text-sm font-medium text-gray-700' %>
                  <%= form.text_field :value, class: 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500', required: true %>
                </div>
                <div>
                  <%= form.label :display_name, "Display Name", class: 'block text-sm font-medium text-gray-700' %>
                  <%= form.text_field :display_name, class: 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500', required: true %>
                </div>
                <div>
                  <%= form.label :position, "Position", class: 'block text-sm font-medium text-gray-700' %>
                  <%= form.number_field :position, class: 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500', 
                      value: PropertyValue.where(property: @property).maximum(:position).to_i + 1, min: 0 %>
                </div>
              </div>
              <div class="flex space-x-3">
                <%= form.submit "Add Value", class: 'bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded' %>
                <button type="button" onclick="toggleAddForm()" 
                        class="bg-gray-400 hover:bg-gray-500 text-white font-bold py-2 px-4 rounded">
                  Cancel
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function toggleAddForm() {
  var form = document.getElementById('addValueForm');
  if (form.style.display === 'none') {
    form.style.display = 'block';
  } else {
    form.style.display = 'none';
  }
}
</script>
