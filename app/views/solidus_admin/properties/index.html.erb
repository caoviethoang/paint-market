<%# Override SolidusAdmin properties index view %>

<div class="bg-white shadow rounded-lg">
  <div class="px-4 py-5 sm:p-6">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Properties</h1>
      <%= link_to "New Property", new_solidus_admin_property_path, 
          class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    </div>

    <!-- Search Form -->
    <div class="mb-6">
      <%= form_with url: solidus_admin_properties_path, method: :get, local: true, class: "flex gap-4" do |f| %>
        <div class="flex-1">
          <%= f.text_field :search, placeholder: "Search properties...", 
              value: params[:search], 
              class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
        <%= f.submit "Search", class: "bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
        <%= link_to "Reset", solidus_admin_properties_path, 
            class: "bg-gray-400 hover:bg-gray-500 text-white font-bold py-2 px-4 rounded" %>
      <% end %>
    </div>

    <!-- Properties Table -->
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <input type="checkbox" id="select-all-properties" class="rounded">
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Name
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Presentation
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Values Count
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @properties.each do |property| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <input type="checkbox" class="property-checkbox rounded" value="<%= property.id %>">
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  <%= link_to property.name, solidus_admin_property_path(property), 
                      class: "text-blue-600 hover:text-blue-900" %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900"><%= property.presentation %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  <%= PropertyValue.where(property: property).count %> values
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <div class="flex space-x-2">
                  <%= link_to "View", solidus_admin_property_path(property), 
                      class: "text-blue-600 hover:text-blue-900" %>
                  <%= link_to "Edit", edit_solidus_admin_property_path(property), 
                      class: "text-indigo-600 hover:text-indigo-900" %>
                  <%= link_to "Delete", solidus_admin_property_path(property), 
                      method: :delete, 
                      data: { confirm: "Are you sure?" },
                      class: "text-red-600 hover:text-red-900" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @properties.empty? %>
      <div class="text-center py-12">
        <div class="text-gray-500 text-lg">No properties found</div>
        <div class="mt-4">
          <%= link_to "Create your first property", new_solidus_admin_property_path, 
              class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
        </div>
      </div>
    <% end %>

    <!-- Pagination -->
    <% if respond_to?(:paginate) && @properties.respond_to?(:current_page) %>
      <div class="mt-6">
        <%= paginate @properties %>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Select all functionality
  const selectAllCheckbox = document.getElementById('select-all-properties');
  const propertyCheckboxes = document.querySelectorAll('.property-checkbox');
  
  if (selectAllCheckbox) {
    selectAllCheckbox.addEventListener('change', function() {
      propertyCheckboxes.forEach(checkbox => {
        checkbox.checked = this.checked;
      });
    });
  }
  
  // Individual checkbox change
  propertyCheckboxes.forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      const checkedCount = document.querySelectorAll('.property-checkbox:checked').length;
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = checkedCount === propertyCheckboxes.length;
        selectAllCheckbox.indeterminate = checkedCount > 0 && checkedCount < propertyCheckboxes.length;
      }
    });
  });
});
</script>
