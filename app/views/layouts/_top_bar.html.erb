<div class="relative flex items-center z-50" data-controller="top-bar">
  <div class="flex items-center gap-x-6">
    <%= render 'shared/search/search_bar', taxons: taxons, taxon: taxon, :locals => { :additional_classes => 'hidden lg:flex' } %>
    
    <%
      available_locales = current_store.available_locales.map do |locale|
        country_code = locale.to_s.upcase
        [country_code, locale]
      end.sort
    %>
    <% if available_locales.many? %>
      <div class="locale-selector relative z-50" data-controller="locale-selector">
        <%= form_tag select_locale_path, method: :post, id: 'locale-form' do %>
          <div class="flex items-center">
            <%= select_tag(:switch_to_locale, 
                options_for_select(available_locales, I18n.locale), 
                class: 'text-sm py-2 bg-white cursor-pointer appearance-none pr-8 relative z-50',
                style: 'border: none !important; position: relative; z-index: 50; pointer-events: auto;',
                id: 'locale-select',
                data: { 
                  action: "locale-selector#submitForm change->locale-selector#switchLocale", 
                  "locale-selector-target" => "selector" 
                }) %>
          </div>
        <% end %>
      </div>
    <% end %>
    
    <div class='relative w-6 h-6 z-50'>
      <svg class='w-6 h-6 fill-black dark:fill-white'>
        <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-shopping-cart-2-line"></use>
      </svg>
      <div id="link-to-cart" class="absolute top-0 left-0 w-full h-full z-50 cursor-pointer" data-top-bar-target="cartLink" style="pointer-events: auto;">
        <noscript>
          <%= link_to t('spree.cart'), cart_path %>
        </noscript>
      </div>
    </div>

    <div class="relative w-6 h-6 z-50">
      <%= link_to spree_current_user ? account_path : login_path, title: spree_current_user ? 'Account' : 'Login', class: 'block w-full h-full' do %>
        <svg class='w-6 h-6 fill-black dark:fill-white'>
          <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-user-line"></use>
        </svg>
      <% end %>
    </div>
  </div>
</div>
