<footer class="bg-[#3B382E] mx-auto w-full pt-7">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
    <div>
      <h2 class="text-h5 font-bold mb-6 text-white">Ha Vy Art</h2>
      <h3 class="uppercase text-lg font-semibold mb-1 text-white"><%= t('spree.footer.information') %></h3>
      <div class="w-16 h-1 bg-yellow-500 mb-4"></div>

      <p class="font-bold mb-2 text-white">MIKE TRAN VIET AN TRADING & SERVICES COMPANY LIMITED</p>
      <p class="text-gray-300 mb-1"><%= t('spree.footer.tax_code') %> : 0000xxxx1234</p>
      <p class="text-gray-300 mb-4">Hotline 24/7 : 0984.xxx.666</p>

      <p class="font-bold mb-1 text-white"><%= t('spree.footer.showroom') %></p>
      <p class="text-gray-300 mb-1"><%= t('spree.footer.phone') %> : 0984.xxx.666</p>
      <p class="text-gray-300"><%= t('spree.footer.adress') %> : 123 Trang Tien, Hoan Kiem , Ha Noi</p>
    </div>
    <div>
      <h3 class="uppercase text-h5 font-semibold mb-1 text-white"> <%= t('spree.footer.our_company') %></h3>
      <div class="w-16 h-1 bg-yellow-500 mb-4"></div>
      <ul class="space-y-2 text-gray-400">
        <li><%= link_to t('spree.shop_art'), products_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200' %></li>
        <li><%= link_to t('spree.our_artist'), products_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200' %></li>
        <li><%= link_to t('spree.event'), events_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200' %></li>
        <li><%= link_to t('spree.about_us'), root_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200' %></li>
      </ul>
    </div>
    <div>
      <h3 class="uppercase text-h5 font-semibold mb-1 text-white"><%= t('spree.footer.connect') %></h3>
      <div class="w-16 h-1 bg-yellow-500 mb-4"></div>
      <div class="bg-gray-200 w-full h-[300px] flex items-center justify-center">
      </div>
    </div>
  </div>
</footer>
