<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%== meta_data_tags %>
    <%= simple_canonical_tag %>
    <%= csrf_meta_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag 'solidus_starter_frontend' %>
    <%= stylesheet_link_tag 'solidus_starter_frontend', media: 'screen' %>

    <%= javascript_importmap_tags %>

    <%= favicon_link_tag 'havyart_logo.png', type: 'image/png' %>

    <script>
      const lsTheme = localStorage.getItem('theme') || 'light'
      document.documentElement.classList.add(lsTheme)
    </script>

    <!-- Fallback JavaScript for production -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const fadeElements = document.querySelectorAll(".scroll-fade");

        const observer = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target); // chỉ chạy 1 lần
              }
            });
          },
          { threshold: 0.2 } // phần tử xuất hiện 20% thì chạy animation
        );

        fadeElements.forEach((el) => observer.observe(el));

        const eventCarouselContainer = document.querySelector('[data-controller*="carousel"]');
        if (eventCarouselContainer) {

          let eventCurrentSlide = 0;
          const eventSlides = eventCarouselContainer.querySelectorAll('[data-carousel-target="slide"]');
          const eventSlidesWrapper = eventCarouselContainer.querySelector('[data-carousel-target="slides"]');

          if (eventSlides.length > 0 && eventSlidesWrapper) {

            // Calculate how many slides to show at once based on screen size
            function getSlidesToShow() {
              if (window.innerWidth < 640) return 1; // sm: 1 slide
              if (window.innerWidth < 1024) return 2; // lg: 2 slides
              return 3; // xl: 3 slides
            }

            function updateEventCarousel() {
              if (eventSlides.length === 0) return;

              const slidesToShow = getSlidesToShow();
              const maxSlide = Math.max(0, eventSlides.length - slidesToShow);

              // Clamp current slide to valid range
              if (eventCurrentSlide > maxSlide) {
                eventCurrentSlide = maxSlide;
              }

              // Lấy thông tin thực tế từ DOM
              const firstSlide = eventSlides[0];
              const computedStyle = window.getComputedStyle(firstSlide);
              const slideWidth = firstSlide.offsetWidth;

              // Lấy gap thực tế từ parent container
              const wrapperStyle = window.getComputedStyle(eventSlidesWrapper);
              const gapValue = wrapperStyle.gap || wrapperStyle.columnGap || '0px';
              const gap = parseInt(gapValue) || (window.innerWidth < 640 ? 8 : 16);

              // Di chuyển chính xác theo slide index
              const translateX = -eventCurrentSlide * (slideWidth + gap);

              console.log('Event carousel - slide:', eventCurrentSlide, 'slideWidth:', slideWidth, 'gap:', gap, 'translateX:', translateX, 'slidesToShow:', slidesToShow);
              eventSlidesWrapper.style.transform = `translateX(${translateX}px)`;
              eventSlidesWrapper.style.transition = 'transform 0.3s ease-in-out';
            }

            function nextEventSlide() {
              const slidesToShow = getSlidesToShow();
              const maxSlide = Math.max(0, eventSlides.length - slidesToShow);

              if (eventCurrentSlide < maxSlide) {
                eventCurrentSlide++;
              } else {
                eventCurrentSlide = 0; // Loop back to first slide
              }
              updateEventCarousel();
            }

            function prevEventSlide() {
              const slidesToShow = getSlidesToShow();
              const maxSlide = Math.max(0, eventSlides.length - slidesToShow);

              if (eventCurrentSlide > 0) {
                eventCurrentSlide--;
              } else {
                eventCurrentSlide = maxSlide; // Loop to last valid slide
              }
              updateEventCarousel();
            }

            // Setup prev/next buttons (desktop only)
            const prevButton = eventCarouselContainer.querySelector('[data-action*="carousel#prev"]');
            const nextButton = eventCarouselContainer.querySelector('[data-action*="carousel#next"]');

            if (prevButton) {
              prevButton.addEventListener('click', function(e) {
                e.preventDefault();
                prevEventSlide();
              });
            }

            if (nextButton) {
              nextButton.addEventListener('click', function(e) {
                e.preventDefault();
                nextEventSlide();
              });
            }

            // Enhanced touch/swipe support (primary interaction on mobile)
            let eventStartX = 0;
            let eventCurrentX = 0;
            let eventIsDragging = false;
            let eventStartTime = 0;

            eventSlidesWrapper.addEventListener('touchstart', function(e) {
              eventStartX = e.touches[0].clientX;
              eventStartTime = Date.now();
              eventIsDragging = true;
              eventSlidesWrapper.style.transition = 'none';
            });

            eventSlidesWrapper.addEventListener('touchmove', function(e) {
              if (!eventIsDragging) return;
              eventCurrentX = e.touches[0].clientX;
              const diffX = eventCurrentX - eventStartX;

              const currentSlideElement = eventSlides[eventCurrentSlide];
              const baseTranslateX = -(currentSlideElement.offsetLeft);
              const translateX = baseTranslateX + diffX;

              eventSlidesWrapper.style.transform = `translateX(${translateX}px)`;
            });

            eventSlidesWrapper.addEventListener('touchend', function(e) {
              if (!eventIsDragging) return;
              eventIsDragging = false;

              const diffX = eventCurrentX - eventStartX;
              const diffTime = Date.now() - eventStartTime;
              const threshold = window.innerWidth * 0.15; // 15% of screen width
              const velocity = Math.abs(diffX) / diffTime; // pixels per ms

              eventSlidesWrapper.style.transition = 'transform 0.3s ease-in-out';

              // Check for swipe gesture (distance or velocity)
              if (Math.abs(diffX) > threshold || velocity > 0.5) {
                if (diffX > 0) {
                  // Swipe right - go to previous slide
                  prevEventSlide();
                } else {
                  // Swipe left - go to next slide
                  nextEventSlide();
                }
              } else {
                // Snap back to current slide
                updateEventCarousel();
              }
            });

            // Mouse support for desktop (optional)
            let mouseStartX = 0;
            let mouseIsDragging = false;

            eventSlidesWrapper.addEventListener('mousedown', function(e) {
              mouseStartX = e.clientX;
              mouseIsDragging = true;
              eventSlidesWrapper.style.transition = 'none';
              e.preventDefault();
            });

            eventSlidesWrapper.addEventListener('mousemove', function(e) {
              if (!mouseIsDragging) return;
              const diffX = e.clientX - mouseStartX;
              const slideWidth = eventSlides[0].offsetWidth;
              const gap = 16;
              const translateX = -eventCurrentSlide * (slideWidth + gap) + diffX;
              eventSlidesWrapper.style.transform = `translateX(${translateX}px)`;
            });

            eventSlidesWrapper.addEventListener('mouseup', function(e) {
              if (!mouseIsDragging) return;
              mouseIsDragging = false;

              const diffX = e.clientX - mouseStartX;
              const threshold = 100; // 100px threshold for mouse

              eventSlidesWrapper.style.transition = 'transform 0.3s ease-in-out';

              if (Math.abs(diffX) > threshold) {
                if (diffX > 0) {
                  prevEventSlide();
                } else {
                  nextEventSlide();
                }
              } else {
                updateEventCarousel();
              }
            });

            // Handle window resize
            window.addEventListener('resize', function() {
              updateEventCarousel();
            });

            // Initialize
            updateEventCarousel();
          }
        }

        // Fallback for locale selector
        const localeSelectors = document.querySelectorAll('select[name="switch_to_locale"]');
        localeSelectors.forEach(function(selector) {
          selector.addEventListener('change', function() {
            const selectedLocale = this.value;
            if (selectedLocale) {
              const form = this.closest('form');
              if (form) {
                form.submit();
              } else {
                window.location.href = '/locale/set?switch_to_locale=' + selectedLocale;
              }
            }
          });
        });

        // Fallback for cart link
        const cartLinks = document.querySelectorAll('#link-to-cart, #link-to-cart-mobile');
        cartLinks.forEach(function(cartLink) {
          cartLink.addEventListener('click', function(e) {
            e.preventDefault();
            window.location.href = '/cart';
          });
        });

        // Fallback for user account link
        const userLinks = document.querySelectorAll('a[href*="login"], a[href*="account"]');
        userLinks.forEach(function(userLink) {
          userLink.addEventListener('click', function(e) {
            // Let the default link behavior work
          });
        });

        // Fallback for hamburger menu
        const hamburgerButtons = document.querySelectorAll('[data-action*="drawer#toggle"]');
        hamburgerButtons.forEach(function(button) {
          button.addEventListener('click', function(e) {
            e.preventDefault();
            const drawer = document.querySelector('[data-drawer-target="drawer"]');
            const overlay = document.getElementById('overlay');

            if (drawer && overlay) {
              drawer.classList.toggle('-translate-x-full');
              overlay.classList.toggle('hidden');
            }
          });
        });

        // Fallback for collapse in filters
        const collapseContainers = document.querySelectorAll('[data-controller="collapse"], [data-controller*="collapse"]');
        collapseContainers.forEach(function(container) {
          const trigger = container.querySelector('[data-action*="collapse#toggle"]');
          const content = container.querySelector('[data-collapse-target="content"], .collapse-content');
          const icon = container.querySelector('[data-collapse-target="icon"], .collapse-icon, svg');

          if (!trigger || !content) return;

          trigger.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const isVisible = !content.classList.contains('hidden');
            if (isVisible) {
              content.classList.add('hidden');
              if (icon) icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>';
            } else {
              content.classList.remove('hidden');
              if (icon) icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 12h12"></path>';
            }
          });
        });
      });

      // Additional fallback for when DOMContentLoaded might not fire
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
        });
      } else {
      }

      // Test function for debugging
      window.testLocaleFunction = function() {
        alert('JavaScript is working! Current locale: ' + (document.querySelector('select[name="switch_to_locale"]')?.value || 'unknown'));
      };
    </script>

    <%= yield :head %>
  </head>

  <body class="<%= body_class %> font-sans" id="<%= @body_id || 'default' %>" data-turbo="false"  data-controller="drawer">
    <div class="min-h-screen flex flex-col">
      <%= render 'layouts/header', taxons: @taxons, taxon: @taxon %>
      <main>
        <% if controller_name == 'products' %>
          <%= render BreadcrumbsComponent.new(
            taxon: @product&.primary_taxon || @taxon,
            item_classes: 'text-body-xs text-gray-500',
            separator_classes: 'text-body-xs text-gray-500 ml-2',
            container_classes: 'flex gap-2',
            wrapper_classes: 'lg:mt-4 px-6',
            order: @order
          ) %>
        <% end %>
        <% if flash_messages.present? %>
          <%= flash_messages %>
        <% end %>
        <%= yield %>
      </main>
      <%= render 'layouts/footer' %>
      <div id="overlay" class="z-40 fixed top-0 left-0 w-full h-full bg-black opacity-50 hidden" data-action="click->drawer#toggle"></div>
    </div>
  </body>
</html>
