<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%== meta_data_tags %>
    <%= simple_canonical_tag %>
    <%= csrf_meta_tags %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag 'solidus_starter_frontend' %>
    <%= stylesheet_link_tag 'solidus_starter_frontend', media: 'screen' %>

    <%= javascript_importmap_tags %>

    <%= favicon_link_tag '/storefront_favicon.svg', type: 'image/svg+xml', rel: 'icon' %>
    <%= favicon_link_tag '/storefront_favicon.ico', rel: 'icon', type: 'image/ico' %>

    <script>
      const lsTheme = localStorage.getItem('theme') || 'light'
      document.documentElement.classList.add(lsTheme)
    </script>

    <!-- Fallback JavaScript for production -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        console.log('Fallback JavaScript loaded');

        // Fallback for locale selector
        const localeSelectors = document.querySelectorAll('select[name="switch_to_locale"]');
        localeSelectors.forEach(function(selector) {
          selector.addEventListener('change', function() {
            const selectedLocale = this.value;
            console.log('Locale change requested:', selectedLocale);
            if (selectedLocale) {
              const form = this.closest('form');
              if (form) {
                console.log('Submitting form');
                form.submit();
              } else {
                console.log('Form not found, redirecting directly');
                window.location.href = '/locale/set?switch_to_locale=' + selectedLocale;
              }
            }
          });
        });

        // Fallback for cart link
        const cartLinks = document.querySelectorAll('#link-to-cart, #link-to-cart-mobile');
        cartLinks.forEach(function(cartLink) {
          cartLink.addEventListener('click', function(e) {
            e.preventDefault();
            console.log('Cart link clicked');
            window.location.href = '/cart';
          });
        });

        // Fallback for user account link
        const userLinks = document.querySelectorAll('a[href*="login"], a[href*="account"]');
        userLinks.forEach(function(userLink) {
          userLink.addEventListener('click', function(e) {
            console.log('User link clicked:', this.href);
            // Let the default link behavior work
          });
        });

        // Fallback for hamburger menu
        const hamburgerButtons = document.querySelectorAll('[data-action*="drawer#toggle"]');
        hamburgerButtons.forEach(function(button) {
          button.addEventListener('click', function(e) {
            e.preventDefault();
            console.log('Hamburger menu clicked');
            const drawer = document.querySelector('[data-drawer-target="drawer"]');
            const overlay = document.getElementById('overlay');

            if (drawer && overlay) {
              drawer.classList.toggle('-translate-x-full');
              overlay.classList.toggle('hidden');
              console.log('Drawer toggled');
            }
          });
        });

        // Fallback for mobile carousel
        const carouselContainer = document.getElementById('mobile-carousel');
        if (carouselContainer) {
          console.log('Mobile carousel found, setting up touch events');

          let startX = 0;
          let currentX = 0;
          let isDragging = false;
          let currentSlide = 0;
          const totalSlides = 6; // 7 images but showing 2 at a time = 6 slides (0-5)

          function updateCarousel() {
            const translateX = -currentSlide * 45;
            console.log('Storefront fallback carousel - slide:', currentSlide, 'translateX:', translateX);
            carouselContainer.style.transform = `translateX(${translateX}%)`;
            updateIndicators();
          }

          function updateIndicators() {
            const indicators = document.querySelectorAll('.carousel-indicator');
            indicators.forEach((indicator, index) => {
              if (index === currentSlide) {
                indicator.classList.remove('bg-gray-300');
                indicator.classList.add('bg-gray-700');
              } else {
                indicator.classList.remove('bg-gray-700');
                indicator.classList.add('bg-gray-300');
              }
            });
          }

          function nextSlide() {
            if (currentSlide < totalSlides - 1) {
              currentSlide++;
            } else {
              currentSlide = 0; // Loop back to first slide
            }
            console.log('Storefront fallback next slide:', currentSlide);
            updateCarousel();
          }

          function prevSlide() {
            if (currentSlide > 0) {
              currentSlide--;
            } else {
              currentSlide = totalSlides - 1; // Loop to last slide
            }
            console.log('Storefront fallback previous slide:', currentSlide);
            updateCarousel();
          }

          carouselContainer.addEventListener('touchstart', function(e) {
            startX = e.touches[0].clientX;
            isDragging = true;
            carouselContainer.style.transition = 'none';
          });

          carouselContainer.addEventListener('touchmove', function(e) {
            if (!isDragging) return;
            currentX = e.touches[0].clientX;
            const diffX = currentX - startX;
            const translateX = -currentSlide * 45 + (diffX / window.innerWidth) * 45;
            carouselContainer.style.transform = `translateX(${translateX}%)`;
          });

          carouselContainer.addEventListener('touchend', function(e) {
            if (!isDragging) return;
            isDragging = false;
            const diffX = currentX - startX;
            const threshold = window.innerWidth * 0.2;

            carouselContainer.style.transition = 'transform 0.3s ease-in-out';

            if (Math.abs(diffX) > threshold) {
              if (diffX > 0) {
                // Swipe right - go to previous slide
                prevSlide();
              } else {
                // Swipe left - go to next slide
                nextSlide();
              }
            } else {
              // Snap back to current slide
              updateCarousel();
            }
          });

          // Initialize
          updateCarousel();
        }

        // Debug information
        console.log('Locale selectors found:', localeSelectors.length);
        console.log('Cart links found:', cartLinks.length);
        console.log('User links found:', userLinks.length);
        console.log('Hamburger buttons found:', hamburgerButtons.length);
        console.log('Carousel container found:', carouselContainer ? 'Yes' : 'No');
      });

      // Additional fallback for when DOMContentLoaded might not fire
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          console.log('DOMContentLoaded fired');
        });
      } else {
        console.log('Document already loaded');
      }

      // Test function for debugging
      window.testLocaleFunction = function() {
        console.log('Test function called');
        alert('JavaScript is working! Current locale: ' + (document.querySelector('select[name="switch_to_locale"]')?.value || 'unknown'));
      };
    </script>

    <%= yield :head %>
  </head>

  <body class="<%= body_class %> " id="<%= @body_id || 'default' %>" data-turbo="false"  data-controller="drawer">
    <div class="min-h-screen grid grid-rows-[auto_1fr_auto]">
      <%= render 'layouts/header', taxons: @taxons, taxon: @taxon %>
      <main>
        <% if controller_name == 'products' %>
          <%= render BreadcrumbsComponent.new(
            taxon: @product&.primary_taxon || @taxon,
            item_classes: 'text-body-xs text-gray-500',
            separator_classes: 'text-body-xs text-gray-500 ml-2',
            container_classes: 'flex gap-2',
            wrapper_classes: 'mt-4 px-6',
            order: @order
          ) %>
        <% end %>
        <% if flash_messages.present? %>
          <%= flash_messages %>
        <% end %>
        <%= yield %>
      </main>
      <%= render 'layouts/footer' %>
      <div id="overlay" class="z-40 fixed top-0 left-0 w-full h-full bg-black opacity-50 hidden" data-action="click->drawer#toggle"></div>
    </div>
  </body>
</html>
