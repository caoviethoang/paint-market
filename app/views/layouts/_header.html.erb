<header class="grid-container px-5 lg:px-6 2xl:px-6 border-b fixed top-0 left-0 w-full bg-white z-50 shadow-sm">
  <div class="col-span-full flex items-center justify-between max-h-[70px] gap-x-6">
    <!-- Logo - Left side -->
    <div class="flex items-center gap-x-4 xl:gap-x-8 justify-start h-full">
      <%= link_to root_path, class: 'h-full flex items-center space-x-3' do %>
        <%= image_tag image_path("havyart.png"), class: "h-full h-6 md:h-8 lg:h-10 w-auto object-contain max-w-[180px] max-h-[50px]", alt: "HAVYART Logo" %>
      <% end %>

      <% navMobileClasses = '
        categories-menu bg-white
        fixed top-0 left-0 z-50 w-full h-full
        transition-transform duration-300 ease-in-out -translate-x-full
        flex flex-col
        lg:bg-sand dark:bg-black dark:text-white text-black dark:lg:text-sand
        px-8 py-5 text-body-sm'
      %>
      <% navDesktopClasses = '
        lg:relative lg:z-0 lg:h-auto lg:max-h-[70px] lg:transition-none lg:translate-x-0
        lg:flex-row lg:items-center
        dark:lg:text-sand
        lg:p-0'
      %>

      <nav class="<%= navMobileClasses + navDesktopClasses %> text-" data-drawer-target="drawer">
        <!-- Close button - Right side -->
        <div class="lg:hidden flex justify-end mb-8">
          <button type="button" class="w-8 h-8" aria-controls="navbar-default" aria-expanded="false" data-action="click->drawer#toggle">
            <span class="sr-only">Close main menu</span>
            <svg class='w-8 h-8 fill-gray-500'>
              <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-close-line"></use>
            </svg>
          </button>
        </div>

        <!-- Mobile Search Bar -->
        <div class="lg:hidden">
          <%= render 'shared/search/search_bar', taxons: taxons, taxon: taxon, :locals => { :additional_classes => 'lg:hidden', search_input_id: 'mobile-search-input-area', results_list_id: 'autocomplete-results-mobile' } %>
        </div>

        <!-- Mobile Navigation Links -->
        <div class="lg:hidden mt-12 text-h3">
          <div class="flex flex-col gap-6 items-center">
            <%= link_to t('spree.home'), root_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200 text-2xl font-bold' %>
            <%= link_to t('spree.shop_art'), products_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200 text-2xl font-bold' %>
            <%= link_to t('spree.event'), events_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200 text-2xl font-bold' %>
            <%= link_to t('spree.about_us'), about_us_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200 text-2xl font-bold' %>

            <!-- Login/Logout Link -->
            <% unless spree_current_user %>
              <%= link_to t('spree.login'), login_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200 text-2xl font-bold' %>
            <% end %>
          </div>
        </div>
      </nav>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center justify-center p-4 text-h6">
      <div class="flex gap-6">
        <%= link_to t('spree.home'), root_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200' %>
        <%= link_to t('spree.shop_art'), products_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200' %>
        <%= link_to t('spree.event'), events_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200' %>
        <%= link_to t('spree.about_us'), about_us_path, class: 'text-gray-600 hover:text-gray-900 transition-colors duration-200' %>
      </div>
    </nav>

    <!-- Right side - Mobile Icons + Desktop Top Bar + Hamburger Menu -->
    <div class="flex items-center gap-x-4">
      <!-- Mobile Icons - Locale + Cart (left of hamburger) -->
      <div class="flex items-center gap-x-3 lg:hidden">
        <div class='relative w-6 h-6 z-10'>
          <svg class='w-6 h-6 fill-black dark:fill-white'>
            <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-shopping-cart-2-line"></use>
          </svg>
          <div id="link-to-cart-mobile" class="absolute top-0 left-0 w-full h-full z-50 cursor-pointer" data-top-bar-target="cartLink" style="pointer-events: auto;">
            <noscript>
              <%= link_to t('spree.cart'), cart_path %>
            </noscript>
          </div>
        </div>
      </div>

      <!-- Top Bar - Hidden on mobile, visible on desktop -->
      <div class="hidden lg:flex items-center">
        <%= render 'layouts/top_bar', taxons: taxons, taxon: taxon %>
      </div>

      <!-- Hamburger Menu - Right side on mobile -->
      <div class="flex items-center justify-center w-8 h-8 lg:hidden">
        <button type="button" class="inline-flex flex-col gap-y-2 items-center p-2 w-10 h-10 justify-center rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-500" aria-controls="navbar-default" aria-expanded="false" data-action="click->drawer#toggle">
          <span class="sr-only">Open main menu</span>
          <svg class="bg-black dark:bg-sand" xmlns="http://www.w3.org/2000/svg" width="26" height="2" viewBox="0 0 26 2" fill="currentColor">
            <line y1="1" x2="26" y2="1" stroke-width="2"/>
          </svg>
          <svg class="bg-black dark:bg-sand" xmlns="http://www.w3.org/2000/svg" width="26" height="2" viewBox="0 0 26 2" fill="currentColor">
            <line y1="1" x2="26" y2="1" stroke-width="2"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
