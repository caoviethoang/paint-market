<section class="taxonomies-menu py-6 sm:py-8 pt-4 sm:pt-7 bg-white">
  <div class="mx-auto px-4 sm:px-6">
    <!-- Mobile Layout - 2 columns -->
    <div class="md:hidden grid grid-cols-2 gap-3" id="taxonomies-container-mobile">
      <% if @taxonomies.present? %>
        <% @taxonomies.first(6).each_with_index do |taxonomy, index| %>
          <% if taxonomy.root.present? %>
            <%= link_to products_path(taxon: taxonomy.root.id),
                class: "px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center",
                data: { taxonomy_id: taxonomy.id } do %>
              <%= taxonomy.name.upcase %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <!-- Fallback buttons if no taxonomies -->
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.paintings') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.abstract_art') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.oil_paintings') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.landscapes') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.portraits') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.modern_art') %>
        </button>
      <% end %>
    </div>

    <!-- Desktop Layout -->
    <div class="hidden md:flex flex-wrap justify-center gap-4" id="taxonomies-container">
      <% if @taxonomies.present? %>
        <% @taxonomies.first(7).each_with_index do |taxonomy, index| %>
          <% if taxonomy.root.present? %>
            <%= link_to products_path(taxon: taxonomy.root.id),
                class: "px-6 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase whitespace-nowrap",
                data: { taxonomy_id: taxonomy.id } do %>
              <%= taxonomy.name.upcase %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <!-- Fallback buttons if no taxonomies -->
        <button class="px-6 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase">
          <%= t('spree.home_page.taxonomies.fallback.paintings') %>
        </button>
        <button class="px-6 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase">
          <%= t('spree.home_page.taxonomies.fallback.abstract_art') %>
        </button>
        <button class="px-6 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase">
          <%= t('spree.home_page.taxonomies.fallback.oil_paintings') %>
        </button>
      <% end %>
    </div>
  </div>

  <div class="celebrate-15-years flex justify-center mb-8 sm:mb-12 mt-4 sm:mt-6 pt-8 sm:pt-12 text-center px-4">
        <h2 class="text-h2.5 font-source-serif-medium text-gray-900 leading-tight">
         <%
           celebrate_text = t('spree.celebrate')
           if I18n.locale == :vi
             celebrate_text = celebrate_text.gsub('15 Năm', '<span class="text-orange">15 năm</span>')
           elsif I18n.locale == :en
             celebrate_text = celebrate_text.gsub('15 Years', '<span class="text-orange">15 Years</span>')
           end
         %>
         <%= celebrate_text.html_safe %>
       </h2>
  </div>
</section>

<section class="bg-cream">
  <div class="max-w-7xl mx-auto text-center">
       <!-- Mobile Layout - Hidden on mobile -->
       <div class="hidden md:flex 7-images mt-4 flex-nowrap justify-center gap-6 py-6 w-full"
          data-controller="image-optimization"
          data-image-optimization-preload-count-value="3"
          data-image-optimization-lazy-load-threshold-value="0.1">
      <% (1..7).each do |index| %>
                                   <div class="flex-shrink-0 relative overflow-hidden rounded-lg shadow-md hover:shadow-lg transition-all duration-300 hover:-translate-y-1 <%= index <= 3 ? 'high-priority' : '' %>"
               style="<%= case index
                          when 1, 3, 5, 7
                            'width: 200px; height: 252px;'
                          when 2, 6
                            'width: 200px; height: 280px;'
                          when 4
                            'width: 200px; height: 200px;'
                          end %>">
          <% if index <= 3 %>
            <%= image_tag image_path("image_#{index}.png"),
                class: "w-full h-full object-cover transition-opacity duration-300",
                alt: "Art Image #{index}",
                loading: "eager",
                fetchpriority: "high",
                data: {
                  image_index: index,
                  image_optimization_target: "image",
                  action: "mouseenter->image-optimization#preloadOnHover"
                } %>
          <% else %>
            <%= image_tag image_path("image_#{index}.png"),
                class: "w-full h-full object-cover transition-opacity duration-300",
                alt: "Art Image #{index}",
                loading: "lazy",
                fetchpriority: "low",
                data: {
                  image_index: index,
                  image_optimization_target: "image",
                  action: "mouseenter->image-optimization#preloadOnHover"
                } %>
          <% end %>


        </div>
      <% end %>
    </div>

    <!-- Mobile Layout - Swipe Carousel (2 images + peek) -->
    <div class="md:hidden 7-images-mobile px-4 w-full mb-10" data-controller="mobile-carousel">
      <div class="relative overflow-hidden">
        <div class="flex transition-transform duration-300 ease-in-out gap-2" id="mobile-carousel" data-mobile-carousel-target="carousel" style="touch-action: pan-x;">
          <% (1..7).each do |index| %>
            <div class="flex-shrink-0 px-1" style="width: 45%;">
              <div class="relative overflow-hidden shadow-md" style="<%= case index
                          when 1, 3, 5, 7
                            'height: 252px;'
                          when 2, 6
                            'height: 280px;'
                          when 4
                            'height: 200px;'
                          end %>">
                <%= image_tag image_path("image_#{index}.png"),
                    class: "w-full h-full object-cover",
                    alt: "Art Image #{index}",
                    loading: "eager" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Carousel Indicators -->
      <div class="flex justify-center mt-4 space-x-2">
        <% (0..5).each do |index| %>
          <div class="w-2 h-2 rounded-full bg-gray-300 carousel-indicator cursor-pointer" data-mobile-carousel-target="indicator" data-slide="<%= index %>" data-action="click->mobile-carousel#goToSlide"></div>
        <% end %>
      </div>
    </div>

    <div class="gap-3 sm:gap-4 grid grid-cols-2 lg:grid-cols-3 md:grid-cols-3 md:mt-8 sm:mt-12 text-left mx-auto max-w-4xl px-4 md:bg-transparent">
      <div class="p-3 sm:p-4 border-l border-gray-400" style="border-left-width: 4px;">
        <p class="text-h4 font-bold text-gray-900 mb-1 sm:mb-2"><%= t('spree.home_page.stats.years') %></p>
        <p class="text-xs uppercase tracking-wider font-medium"><%= t('spree.made_easy') %></p>
      </div>
      <div class="p-3 sm:p-4 border-l border-gray-400" style="border-left-width: 4px;">
        <p class="text-h4 font-bold text-gray-900 mb-1 sm:mb-2"><%= t('spree.home_page.stats.homes') %></p>
        <p class="text-xs uppercase tracking-wider font-medium"><%= t('spree.home_with_art') %></p>
      </div>
      <div class="p-3 sm:p-4 border-l border-gray-400" style="border-left-width: 4px;">
        <p class="text-h4 font-bold text-gray-900 mb-1 sm:mb-2"><%= t('spree.home_page.stats.countries') %></p>
        <p class="text-xs uppercase tracking-wider font-medium"><%= t('spree.collector_countries') %></p>
      </div>
      <div class="p-3 sm:p-4 border-l border-gray-400" style="border-left-width: 4px;">
        <p class="text-h4 font-bold text-gray-900 mb-1 sm:mb-2"><%= t('spree.home_page.stats.artists') %></p>
        <p class="text-xs uppercase tracking-wider font-medium"><%= t('spree.artists_collected') %></p>
      </div>
      <div class="p-3 sm:p-4 border-l border-gray-400" style="border-left-width: 4px;">
        <p class="text-h4 font-bold text-gray-900 mb-1 sm:mb-2"><%= t('spree.home_page.stats.artworks') %></p>
        <p class="text-xs uppercase tracking-wider font-medium"><%= t('spree.artworks_sold') %></p>
      </div>
      <div class="p-3 sm:p-4 border-l border-gray-400" style="border-left-width: 4px;">
        <p class="text-h4 font-bold text-gray-900 mb-1 sm:mb-2"><%= t('spree.home_page.stats.artist_countries') %></p>
        <p class="text-xs uppercase tracking-wider font-medium"><%= t('spree.artist_countries') %></p>
      </div>
    </div>
  </div>
</section>

<section id="example-taxonomies" class="py-8 sm:py-12 px-4 sm:px-6 bg-white">
  <% if @example_taxonomies.present? %>
    <div class="md:container mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        <% @example_taxonomies.each do |taxonomy_data| %>
          <div class="flex flex-col">

            <!-- Single product image -->
            <div class="mb-6">
              <div class="aspect-square overflow-hidden shadow-md">
                <% if taxonomy_data[:image].present? %>
                  <%= image_tag taxonomy_data[:image].url(:small),
                      class: 'w-full h-full object-cover hover:scale-110 transition-transform duration-300',
                      alt: "#{taxonomy_data[:product].name} Image" %>
                <% else %>
                  <!-- Fallback placeholder -->
                  <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
                    <span class="text-gray-500 text-sm font-medium">
                      <%= taxonomy_data[:taxonomy].name %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="mb-6 h-full">
              <h3 class="text-h4 font-semibold text-gray-900 mb-3">
                <%= taxonomy_data[:taxonomy].name %>
              </h3>
              <% if taxonomy_data[:taxonomy].description.present? %>
                <p class="text-sm text-gray-500 max-w-sm">
                  <%= truncate(taxonomy_data[:taxonomy].description, length: 120) %>
                </p>
              <% end %>
            </div>

            <!-- Shop button -->
            <% if taxonomy_data[:taxonomy].root.present? %>
              <%= link_to products_path(taxon: taxonomy_data[:taxonomy].root.id),
                  class: "mt-4 px-6 py-3 text-center border-2 border-gray-500 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors duration-200" do %>
                <%= t('spree.home_page.shop_button') %> <%= taxonomy_data[:taxonomy].name %>
              <% end %>
            <% else %>
              <a href="#" class="mt-4 px-6 py-3 text-center border-2 border-gray-500 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors duration-200">
                <%= t('spree.home_page.shop_button') %> <%= taxonomy_data[:taxonomy].name %>
              </a>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

