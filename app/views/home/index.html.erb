<section class="bg-[#F8F4ED] py-16 weekly-art">
  <div class="container mx-auto text-center">
    <!-- Tiêu đề -->
         <h2 class="text-h2.5 font-source-serif font-medium text-[#3B382E] mb-2">
       Discover new art added weekly
     </h2>
    <div class="w-24 h-[1px] bg-[#3B382E] mx-auto mb-10"></div>

    <!-- Grid ảnh -->
    <div class="grid gap-8 mb-10">
      <ul class="gap-7 flex text-left">
        <% @new_arrivals.each do |product| %>
          <% cache [I18n.locale, current_pricing_options, @taxon, product] do %>
            <%= render ProductCardComponent.new(
              product,
              price: nil,
              additional_classes: "col-span-full md:col-span-6 lg:col-span-4"
            ) %>
          <% end %>
        <% end %>
      </ul>
    </div>

    <button class="mt-8 px-6 py-3 bg-[#424242] text-white font-medium rounded-md hover:bg-gray-700 transition duration-300">
      Browse New Art
    </button>
  </div>
</section>

