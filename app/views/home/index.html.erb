<section class="bg-[#F8F4ED] py-12 sm:py-16 weekly-art">
  <div class="md:container mx-auto text-center px-4 sm:px-6">
    <!-- Tiêu đề -->
         <h2 class="text-xl sm:text-2xl md:text-h2.5 font-source-serif font-medium text-[#3B382E] mb-2">
       <%= t('spree.home_page.weekly_art.title') %>
     </h2>
    <div class="bg-[#3B382E] h-[1px] mb-6 sm:mb-10 mx-auto w-1_col-30"></div>

    <!-- Grid ảnh -->
    <div class="grid gap-6 sm:gap-8 mb-6 sm:mb-10">
      <ul class="gap-4 sm:gap-7 flex flex-col sm:flex-row text-left">
        <% @new_arrivals.each do |product| %>
          <% cache [I18n.locale, current_pricing_options, @taxon, product] do %>
            <%= render ProductCardComponent.new(
              product,
              price: nil,
              additional_classes: "col-span-full md:col-span-6 lg:col-span-4"
            ) %>
          <% end %>
        <% end %>
      </ul>
    </div>

    <button class="mt-6 sm:mt-8 px-4 sm:px-6 py-2 sm:py-3 bg-[#424242] text-white font-medium rounded-md hover:bg-gray-700 transition duration-300 text-sm sm:text-base">
      <%= t('spree.home_page.weekly_art.cta_button') %>
    </button>
  </div>
</section>

