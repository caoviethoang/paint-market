  <section class="py-8 discovery" style="background-color: rgb(239 223 197)">
    <div class="md:container mx-auto text-center px-4 sm:px-4">
      <div class="section-title md:container mx-auto mb-8">
        <span class="lg:text-h2.5 md:text-h2.5"><%= t('spree.home_page.weekly_art.title') %></span>
      </div>

      <!-- Grid ảnh -->
      <div class="grid gap-6 sm:gap-8 mb-6 sm:mb-10 discovery-grid-col">
        <div class="newest flex flex-col items-start ">
          <span class="widget-title text-h6">Mới nhất</span>
          <div class="is-divider small"></div>
          <% @newest.each do |product| %>
            <% cache [I18n.locale, current_pricing_options, @taxon, product] do %>
              <%= render DiscoveryCardComponent.new(product) %>
            <% end %>
          <% end %>
        </div>
        <div class="outstanding flex flex-col items-start ">
          <span class="widget-title text-h6">Nổi bật</span>
          <div class="is-divider small"></div>
          <% @outstanding.each do |product| %>
            <% cache [I18n.locale, current_pricing_options, @taxon, product] do %>
              <%= render DiscoveryCardComponent.new(product) %>
            <% end %>
          <% end %>
        </div>
        <div class="overatting flex flex-col items-start ">
          <span class="widget-title text-h6">Đánh giá cao</span>
          <div class="is-divider small"></div>
          <% @overatting.each do |product| %>
            <% cache [I18n.locale, current_pricing_options, @taxon, product] do %>
              <%= render DiscoveryCardComponent.new(product) %>
            <% end %>
          <% end %>
        </div>
        <div class="care flex flex-col items-start ">
          <span class="widget-title text-h6">Quan tâm</span>
          <div class="is-divider small"></div>
          <% @care.each do |product| %>
            <% cache [I18n.locale, current_pricing_options, @taxon, product] do %>
              <%= render DiscoveryCardComponent.new(product) %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .fote-top {
    margin-bottom: -1px;
  }

  .fote-bottom {
    margin-top: -1px;
    transform: rotate(180deg);
  }

  .is-divider {
    height: 3px;
    display: block;
    background-color: rgba(0, 0, 0, .1);
    margin: 1em 0 1em;
    width: 100%;
    max-width: 30px;
  }

