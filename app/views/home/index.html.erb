<section class="banner relative w-full scroll-fade">
  <div class="inset-0">
    <%= link_to detail_event_path(@event), class: "block" do %>
      <div class="relative overflow-hidden group-hover:shadow-xl transition-shadow duration-300">
        <%= image_tag event_image_url(@event, :large),
            class: "w-full h-48 sm:h-64 custom-lg-height transition-transform duration-300",
            alt: @event.title %>
      </div>
    <% end %>
  </div>

  <!-- Desktop Layout -->
  <div class="hidden md:block bg-[#F5F3F0] absolute z-10 flex items-center left-8 bottom-8" style="left: 5%; bottom: 10%;">
    <div class="max-w-7xl mx-auto px-8 sm:px-12 lg:px-12 mt-4">
      <div class="max-w-lg">
        <h1 class="text-h5 md:text-h5 lg:text-h5 font-source-serif text-black leading-tight mb-6">
          <%= @event.title %>
        </h1>
        <p class="text-base md:text-lg text-black leading-relaxed max-w-md font-inter">
          <%= @event.display_duration %>
        </p>
        <%= link_to products_path, class: "hover:text-primary inline-block py-3 text-black tracking-wide underline font-inter-medium" do %>
          <%= t('spree.home_page.banner.cta_button') %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Mobile Layout - Separate section below banner -->
<section class="md:hidden py-8 px-4 scroll-fade">
  <div>
    <h1 class="text-h4 font-source-serif text-black leading-tight mb-4">
      <%= @event.title %>
    </h1>
    <p class="text-sm sm:text-base text-black leading-relaxed mb-6 font-inter">
      <%= @event.display_duration %>
    </p>
    <%= link_to products_path, class: "hover:text-primary inline-block py-2 text-black tracking-wide underline font-inter-medium text-sm" do %>
      <%= t('spree.home_page.banner.cta_button') %>
    <% end %>
  </div>
</section>

<section class="taxonomies-menu py-6 sm:py-8 pt-4 sm:pt-7 bg-white scroll-fade">
  <div class="mx-auto px-4 sm:px-4">
    <!-- Mobile Layout - 2 columns -->
    <div class="md:hidden grid grid-cols-2 gap-3" id="taxonomies-container-mobile">
      <% if @taxonomies.present? %>
        <% @taxonomies.first(6).each_with_index do |taxonomy, index| %>
          <% if taxonomy.root.present? %>
            <%= link_to products_path(taxon: taxonomy.root.id),
                class: "px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center",
                data: { taxonomy_id: taxonomy.id } do %>
              <%= taxonomy.name.upcase %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <!-- Fallback buttons if no taxonomies -->
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.paintings') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.abstract_art') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.oil_paintings') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.landscapes') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.portraits') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-xs font-medium tracking-wide uppercase text-center">
          <%= t('spree.home_page.taxonomies.fallback.modern_art') %>
        </button>
      <% end %>
    </div>

    <!-- Desktop Layout -->
    <div class="hidden md:flex flex-wrap justify-center gap-4" id="taxonomies-container">
      <% if @taxonomies.present? %>
        <% @taxonomies.each_with_index do |taxonomy, index| %>
          <% if taxonomy.root.present? %>
            <%= link_to products_path(taxon: taxonomy.root.id),
                class: "px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase whitespace-nowrap",
                data: { taxonomy_id: taxonomy.id } do %>
              <%= taxonomy.name.upcase %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <!-- Fallback buttons if no taxonomies -->
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase">
          <%= t('spree.home_page.taxonomies.fallback.paintings') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase">
          <%= t('spree.home_page.taxonomies.fallback.abstract_art') %>
        </button>
        <button class="px-4 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase">
          <%= t('spree.home_page.taxonomies.fallback.oil_paintings') %>
        </button>
      <% end %>
    </div>
  </div>

</section>

<!-- Product USP Section -->
<section class="py-8 px-4 my-8 bg-[#F8F4ED] scroll-fade">
  <div class="md:container mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <div class="w-16 h-16 rounded-full bg-white shadow-md flex items-center justify-center border-2 border-orange">
            <i data-lucide="award" class="w-8 h-8 text-orange"></i>
          </div>
        </div>
        <div class="flex-1">
          <div class="font-bold text-gray-900 lg:text-h6 md:text-h6 mb-2">Chất lượng</div>
          <div class="relative inline-block">
            <p class="text-gray-600 text-sm leading-relaxed" style="font-family: 'Dancing Script', 'Pacifico', cursive; font-size: 17px;">
              Đảm bảo chất lượng những dịch vụ tốt nhất.
            </p>
            <svg class="absolute -bottom-1 left-0 w-full" height="8" viewBox="0 0 300 8" preserveAspectRatio="none">
              <path d="M0,5 Q30,2 60,5 T120,5 Q150,2 180,5 T240,5 Q270,2 300,5" fill="none" stroke="#60a5fa" stroke-width="3.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <div class="w-16 h-16 rounded-full bg-white shadow-md flex items-center justify-center border-2 border-red-400">
            <i data-lucide="zap" class="w-8 h-8 text-red-500"></i>
          </div>
        </div>
        <div class="flex-1">
          <div class="font-bold text-gray-900 lg:text-h6 md:text-h6 mb-2">Tốc độ</div>
          <div class="relative inline-block">
            <p class="text-gray-600 text-sm leading-relaxed" style="font-family: 'Dancing Script', 'Pacifico', cursive; font-size: 17px;">
              Giao hàng nhanh chóng đến địa chỉ khách hàng.
            </p>
            <svg class="absolute -bottom-1 left-0 w-full" height="8" viewBox="0 0 300 8" preserveAspectRatio="none">
              <path d="M0,5 Q30,2 60,5 T120,5 Q150,2 180,5 T240,5 Q270,2 300,5" fill="none" stroke="#60a5fa" stroke-width="3.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <div class="w-16 h-16 rounded-full bg-white shadow-md flex items-center justify-center border-2 border-blue">
            <i data-lucide="headphones" class="w-8 h-8 text-blue"></i>
          </div>
        </div>
        <div class="flex-1">
          <div class="font-bold text-gray-900 lg:text-h6 md:text-h6 mb-2">Trợ giúp</div>
          <div class="relative inline-block">
            <p class="text-gray-600 text-sm leading-relaxed" style="font-family: 'Dancing Script', 'Pacifico', cursive; font-size: 17px;">
              Tư vấn và hỗ giúp đặt hàng nhanh chóng.
            </p>
            <svg class="absolute -bottom-1 left-0 w-full" height="8" viewBox="0 0 300 8" preserveAspectRatio="none">
              <path d="M0,5 Q30,2 60,5 T120,5 Q150,2 180,5 T240,5 Q270,2 300,5" fill="none" stroke="#60a5fa" stroke-width="3.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="md:container mx-auto mt-12">
    <span><b>Tranh Phong Cảnh, Tranh Tĩnh Vật, Chất Lượng Cao!</b></span></br>
    <span><b>Hà Vy Art</b> đang mang đến cho không gian của bạn thêm phần sống động, nhiều màu sắc, sự tinh tế,
    vẻ đẹp thông qua những những bức tranh sơn dầu, tranh sơn mài, tranh phong cảnh, tranh trừu tượng,
    tranh nghệ thuật <b>đẹp nhất từ hàng trăm họa sĩ tài năng và giàu kinh nghiệm tại Việt Nam</b>.
    Những bức tranh độc bản được sáng tác đậm chất nghệ thuật và độc đáo nhất mà bạn không thể tìm được thấy
    được ở nơi nào khác đảm bảo sẽ đem đến sự hài lòng cho các bạn.</span>
  </div>
</section>

<div class="mt-12 section-title md:container mx-auto scroll-fade">
  <span class="lg:text-h2.5 md:text-h2.5">Danh Mục Tranh Nổi Bật</span>
</div>

<section id="example-taxonomies" class="py-8 sm:py-12 px-4 sm:px-4 bg-white scroll-fade">
  <% if @example_taxonomies.present? %>
    <div class="md:container mx-auto">
      <div class="grid grid-cols-1 custom-grid-col gap-6 sm:gap-8">
        <% @example_taxonomies.each do |taxonomy_data| %>
          <div class="flex flex-col justify-between">

            <!-- Single product image -->
            <div class="mb-6">
              <div class="custom-square">
                <% if taxonomy_data[:image].present? %>
                  <%= image_tag taxonomy_data[:image].url(:small),
                      class: 'w-full h-full object-cover hover:scale-105 transition-transform duration-300',
                      alt: "#{taxonomy_data[:product].name} Image" %>
                <% else %>
                  <!-- Fallback placeholder -->
                  <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
                    <span class="text-gray-500 text-sm font-medium">
                      <%= taxonomy_data[:taxonomy].name %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="mb-6">
              <h3 class="text-h4 font-semibold text-gray-900 mb-3">
                <%= taxonomy_data[:taxonomy].name %>
              </h3>
              <% if taxonomy_data[:taxonomy].description.present? %>
                <p class="text-sm text-gray-500 max-w-sm">
                  <%= truncate(taxonomy_data[:taxonomy].description, length: 120) %>
                </p>
              <% end %>
            </div>

            <!-- Shop button -->
              <% if taxonomy_data[:taxonomy].root.present? %>
                <%= link_to products_path(taxon: taxonomy_data[:taxonomy].root.id),
                    class: "px-4 py-3 text-center border-2 border-gray-500 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors duration-200" do %>
                  <%= t('spree.home_page.shop_button') %> <%= taxonomy_data[:taxonomy].name %>
                <% end %>
              <% else %>
                <a href="#" class="px-4 py-3 text-center border-2 border-gray-500 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors duration-200">
                  <%= t('spree.home_page.shop_button') %> <%= taxonomy_data[:taxonomy].name %>
                </a>
              <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

<section class="bg-[#F8F4ED] py-8 weekly-art scroll-fade">
  <div class="md:container mx-auto text-center px-4 sm:px-4">
    <div class="section-title md:container mx-auto mb-8">
      <span class="lg:text-h2.5 md:text-h2.5"><%= t('spree.home_page.weekly_art.title') %></span>
    </div>

    <!-- Grid ảnh -->
    <div class="grid gap-6 sm:gap-8 mb-6 sm:mb-10">
      <ul class="gap-4 sm:gap-7 flex flex-col sm:flex-row text-left">
        <% @new_arrivals.each do |product| %>
          <% cache [I18n.locale, current_pricing_options, @taxon, product] do %>
            <%= render ProductCardComponent.new(
              product,
              price: nil,
              additional_classes: "col-span-full md:col-span-6 lg:col-span-4"
            ) %>
          <% end %>
        <% end %>
      </ul>
    </div>

    <button class="px-4 sm:px-4 py-2 sm:py-3 bg-[#424242] text-white font-medium rounded-md hover:bg-gray-700 transition duration-300 text-sm sm:text-base">
      <%= t('spree.home_page.weekly_art.cta_button') %>
    </button>
  </div>
</section>

<style>
  .section-title {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 18px;
    color: #3b382e; /* Màu chữ nâu đậm nhẹ */
  }

  .section-title::before,
  .section-title::after {
    content: "";
    flex: 1;
    border-bottom: 1px solid #dcdcdc; /* Màu xám nhạt */
    margin: 0 12px; /* Khoảng cách giữa đường kẻ và chữ */
  }

  .section-title span {
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .border-orange {
    --tw-border-opacity: 1;
    border-color: rgb(246 128 80 / var(--tw-border-opacity, 1));
  }

  .border-blue {
    --tw-border-opacity: 1;
    border-color: rgb(64 77 216 / var(--tw-border-opacity, 1));
  }

  .text-blue {
    --tw-border-opacity: 1;
    border-color: rgb(64 77 216 / var(--tw-border-opacity, 1));
  }

  .scroll-fade {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s ease-out;
  }

  .scroll-fade.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (min-width: 451px) {
    .custom-lg-height {
      height: 30rem !important;
    }

    .custom-square {
      aspect-ratio: 1.5 / 1;
    }

    .custom-grid-col {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

  }
</style>
