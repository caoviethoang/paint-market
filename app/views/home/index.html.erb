<section class="taxonomies-menu py-8 pt-7 bg-white">
  <div class="mx-auto">
    <div class="flex flex-wrap justify-center gap-4" id="taxonomies-container">
      <% if @taxonomies.present? %>
        <% @taxonomies.first(7).each_with_index do |taxonomy, index| %>
          <% if taxonomy.root.present? %>
            <%= link_to products_path(taxon: taxonomy.root.id),
                class: "px-6 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase whitespace-nowrap",
                data: { taxonomy_id: taxonomy.id } do %>
              <%= taxonomy.name.upcase %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <!-- Fallback buttons if no taxonomies -->
        <button class="px-6 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase">
          PAINTINGS
        </button>
        <button class="px-6 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase">
          ABSTRACT ART
        </button>
        <button class="px-6 py-3 border border-gray-900 text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 text-sm font-medium tracking-wide uppercase">
          OIL PAINTINGS
        </button>
      <% end %>
    </div>
  </div>

  <div class="celebrate-15-years flex justify-center mb-12 mt-6 pt-12 text-center">
           <h2 class="text-h2.5 font-source-serif-medium text-gray-900">
         Celebrate <span class="text-orange">15 Years</span> of Discovering Art You Love
       </h2>
  </div>
</section>

<section class="bg-cream py-16">
  <div class="max-w-7xl mx-auto px-6 text-center">
       <div class="7-images mt-4 flex flex-nowrap justify-center gap-6 px-6 py-6 w-full"  
          data-controller="image-optimization"
          data-image-optimization-preload-count-value="3"
          data-image-optimization-lazy-load-threshold-value="0.1">
      <% (1..7).each do |index| %>
                                   <div class="flex-shrink-0 relative overflow-hidden rounded-lg shadow-md hover:shadow-lg transition-all duration-300 hover:-translate-y-1 <%= index <= 3 ? 'high-priority' : '' %>"
               style="<%= case index
                          when 1, 3, 5, 7
                            'width: 200px; height: 252px;'
                          when 2, 6
                            'width: 200px; height: 280px;'
                          when 4
                            'width: 200px; height: 200px;'
                          end %>">
          <% if index <= 3 %>
            <%= image_tag s3_image_url("image_#{index}.png"),
                class: "w-full h-full object-cover transition-opacity duration-300",
                alt: "Art Image #{index}",
                loading: "eager",
                fetchpriority: "high",
                data: { 
                  image_index: index,
                  image_optimization_target: "image",
                  action: "mouseenter->image-optimization#preloadOnHover"
                } %>
          <% else %>
            <%= image_tag s3_image_url("image_#{index}.png"),
                class: "w-full h-full object-cover transition-opacity duration-300",
                alt: "Art Image #{index}",
                loading: "lazy",
                fetchpriority: "low",
                data: { 
                  image_index: index,
                  image_optimization_target: "image",
                  action: "mouseenter->image-optimization#preloadOnHover"
                } %>
          <% end %>
          

        </div>
      <% end %>
    </div>

        <div class="gap-4 grid grid-cols-1 lg:grid-cols-3 md:grid-cols-3 mt-12 sm:grid-cols-2 text-center mx-auto max-w-4xl">
          <div class="p-4 border-l border-gray-400" style="border-left-width: 4px;">
            <p class="text-h3 font-inter-semibold text-gray-900 mb-2">30</p>
            <p class="text-xs uppercase tracking-wider font-inter-medium"><%= t('spree.made_easy') %></p>
          </div>
          <div class="p-4 border-l border-gray-400" style="border-left-width: 4px;">
            <p class="text-h3 font-inter-semibold text-gray-900 mb-2">130,000+</p>
            <p class="text-xs uppercase tracking-wider font-inter-medium"><%= t('spree.home_with_art') %></p>
          </div>
          <div class="p-4 border-l border-gray-400" style="border-left-width: 4px;">
            <p class="text-h3 font-inter-semibold text-gray-900 mb-2">153</p>
            <p class="text-xs uppercase tracking-wider font-inter-medium"><%= t('spree.collector_countries') %></p>
          </div>
          <div class="p-4 border-l border-gray-400" style="border-left-width: 4px;">
            <p class="text-h3 font-inter-semibold text-gray-900 mb-2">100,000+</p>
            <p class="text-xs uppercase tracking-wider font-inter-medium"><%= t('spree.artists_collected') %></p>
          </div>
          <div class="p-4 border-l border-gray-400" style="border-left-width: 4px;">
            <p class="text-h3 font-inter-semibold text-gray-900 mb-2">330,000+</p>
            <p class="text-xs uppercase tracking-wider font-inter-medium"><%= t('spree.artworks_sold') %></p>
          </div>
          <div class="p-4 border-l border-gray-400" style="border-left-width: 4px;">
            <p class="text-h3 font-inter-semibold text-gray-900 mb-2">143</p>
            <p class="text-xs uppercase tracking-wider font-inter-medium"><%= t('spree.artist_countries') %></p>
          </div>
        </div>
  </div>
</section>

<section id="example-taxonomies" class="py-12 px-6 bg-white border-b-2 border-gray-300">
  <% if @example_taxonomies.present? %>
    <div class="container mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @example_taxonomies.each do |taxonomy_data| %>
          <div class="flex flex-col">

            <!-- Single product image -->
            <div class="mb-6">
              <div class="aspect-square overflow-hidden shadow-md">
                <% if taxonomy_data[:image].present? %>
                  <%= image_tag taxonomy_data[:image].url(:small),
                      class: 'w-full h-full object-cover hover:scale-110 transition-transform duration-300',
                      alt: "#{taxonomy_data[:product].name} Image" %>
                <% else %>
                  <!-- Fallback placeholder -->
                  <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
                    <span class="text-gray-500 text-sm font-medium">
                      <%= taxonomy_data[:taxonomy].name %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="mb-6 h-full">
              <h3 class="text-h4 font-semibold text-gray-900 mb-3">
                <%= taxonomy_data[:taxonomy].name %>
              </h3>
              <% if taxonomy_data[:taxonomy].description.present? %>
                <p class="text-sm text-gray-500 max-w-sm">
                  <%= truncate(taxonomy_data[:taxonomy].description, length: 120) %>
                </p>
              <% end %>
            </div>

            <!-- Shop button -->
            <% if taxonomy_data[:taxonomy].root.present? %>
              <%= link_to products_path(taxon: taxonomy_data[:taxonomy].root.id),
                  class: "mt-4 px-6 py-3 text-center border-2 border-gray-500 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors duration-200" do %>
                Shop <%= taxonomy_data[:taxonomy].name %>
              <% end %>
            <% else %>
              <a href="#" class="mt-4 px-6 py-3 text-center border-2 border-gray-500 text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors duration-200">
                Shop <%= taxonomy_data[:taxonomy].name %>
              </a>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

<section id="all-taxos" class="bg-[#fdf3e2] py-16 px-6">
  <div class="container mx-auto max-w-6xl text-center">
    <% if @taxonomies.present? %>
      <%# Display all taxonomies in a single horizontal row with clickable links %>
      <div class="flex flex-wrap justify-center gap-6 mb-8">
        <% @taxonomies.each do |taxonomy| %>
          <% if taxonomy.root.present? %>
            <%= link_to products_path(taxon: taxonomy.root.id), 
                class: "hover:text-primary mx-2 my-2 text-h2.5 sm:text-4xl md:text-5xl font-source-serif text-gray-800 hover:text-gray-600 transition-colors duration-300 cursor-pointer" do %>
              <%= taxonomy.name %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%# Fallback if no taxonomies available %>
      <div class="flex flex-wrap justify-center gap-6 mb-8">
        <a href="#" class="mx-2 my-2 text-h2.5 sm:text-4xl md:text-5xl font-source-serif text-gray-800 hover:text-gray-600 transition-colors duration-300 cursor-pointer">Paintings</a>
        <a href="#" class="mx-2 my-2 text-h2.5 sm:text-4xl md:text-5xl font-source-serif text-gray-800 hover:text-gray-600 transition-colors duration-300 cursor-pointer">Abstract Art</a>
        <a href="#" class="mx-2 my-2 text-h2.5 sm:text-4xl md:text-5xl font-source-serif text-gray-800 hover:text-gray-600 transition-colors duration-300 cursor-pointer">Oil Paintings</a>
        <a href="#" class="mx-2 my-2 text-h2.5 sm:text-4xl md:text-5xl font-source-serif text-gray-800 hover:text-gray-600 transition-colors duration-300 cursor-pointer">Landscapes</a>
        <a href="#" class="mx-2 my-2 text-h2.5 sm:text-4xl md:text-5xl font-source-serif text-gray-800 hover:text-gray-600 transition-colors duration-300 cursor-pointer">Portraits</a>
        <a href="#" class="mx-2 my-2 text-h2.5 sm:text-4xl md:text-5xl font-source-serif text-gray-800 hover:text-gray-600 transition-colors duration-300 cursor-pointer">Modern Art</a>
      </div>
    <% end %>

    <p class="text-h6 text-gray-700 mt-8 font-inter">
      Seeking something special?</br>Start searching with specific characteristics and narrow your options.
    </p>
  </div>
</section>

