<div class="p-2 sm:p-4">
  <% if @event.display_image_urls(:medium).present? %>
    <div class="relative" data-controller="carousel lightbox">
      <!-- Nút Prev -->
      <button data-action="click->carousel#prev"
              class="absolute left-1 sm:left-0 top-1/2 -translate-y-1/2 p-1.5 sm:p-2 bg-white rounded-full shadow-md z-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-6 sm:w-6" fill="none"
            viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Nút Next -->
      <button data-action="click->carousel#next"
              class="absolute right-1 sm:right-0 top-1/2 -translate-y-1/2 p-1.5 sm:p-2 bg-white rounded-full shadow-md z-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-6 sm:w-6" fill="none"
            viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Carousel -->
      <div class="overflow-x-auto overflow-y-hidden scrollbar-hide">
        <div data-carousel-target="slides"
            class="flex gap-2 sm:gap-4">
          <% @event.display_image_urls(:medium).each_with_index do |url, index| %>
            <%= image_tag url,
                class: "block flex-shrink-0 w-60 sm:w-80 max-h-[150px] sm:max-h-[200px] object-cover hover:scale-105 transition cursor-pointer",
                data: {
                  "carousel-target": "slide",
                  action: "click->lightbox#open",
                  lightbox_url: url
                } %>
          <% end %>
        </div>
      </div>

      <!-- Modal zoom ảnh -->
      <div data-lightbox-target="modal"
          data-action="click->lightbox#closeBackground"
          class="fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-[9999] hidden">
        <div class="relative">
          <img data-lightbox-target="image" src="" alt="Ảnh phóng to"
              class="max-w-[90%] max-h-[90%] transition-transform duration-200">
          <button data-action="lightbox#close"
                  class="absolute mr-4 right-0 text-h2.5 top-0">&times;</button>

          <!-- Nút Zoom -->
          <div class="absolute flex items-center bg-black bg-opacity-50 rounded-full text-white z-20">
            <button data-action="lightbox#zoomIn"
                    class="p-1 hover:bg-opacity-75 rounded-l-full">
              <svg class="w-5 h-5" fill="none" stroke="currentColor"
                  viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 4v16m8-8H4"></path>
              </svg>
            </button>
            <div class="h-5 w-px bg-white bg-opacity-50"></div>
            <button data-action="lightbox#zoomOut"
                    class="p-1 hover:bg-opacity-75 rounded-r-full">
              <svg class="w-5 h-5" fill="none" stroke="currentColor"
                  viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M20 12H4"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mt-6 sm:mt-8 mx-auto event-preview">
    <div>
      <% if @event.present? %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
          <div>
            <h3 class="text-base sm:text-lg text-gray-500"><%= t('spree.events.pages.show') %></h3>
            <h2 class="text-xl sm:text-2xl lg:text-h3 leading-tight">
              <%= @event.title %>
            </h2>
            <p class="text-lg sm:text-xl lg:text-h4 text-gray-500 mt-3 sm:mt-4">
              <%= @event.start_time.strftime('%B %e') %> – <%= @event.end_time.strftime('%B %e, %Y') %>
            </p>

            <div class="mt-6 sm:mt-8">
              <p class="text-sm sm:text-base"><%= @event.location %></p>
              <p class="text-sm sm:text-base"><%= @event.display_operating_hours%></p>
            </div>
          </div>
          <div>
            <h3 class="text-base sm:text-lg text-gray-500"><%= t('spree.events.pages.about') %></h3>
            <p class="mt-2 text-sm sm:text-base leading-relaxed">
              <%= @event.description %>
            </p>

            <div class="mt-3 sm:mt-4">
              <%= link_to t('spree.events.pages.more_info'), event_path(@event), class: "inline-block text-xs sm:text-sm underline" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 sm:mt-8 mx-auto">
    <% if @products.present? %>
      <h2 class="mb-4 sm:mb-6 text-lg sm:text-xl lg:text-2xl font-bold text-gray-900"> <%= @products.total_count %> <%= t('spree.events.pages.art_works') %> </h2>
      <%= render 'products/products', products: @products, taxon: nil %>
    <% else %>
      <h2 class="mb-4 sm:mb-6 text-lg sm:text-xl lg:text-2xl font-bold text-gray-900"><%= t('spree.events.pages.no_art_works') %></h2>
    <% end %>
  </div>
</div>

<div class="mt-4 bg-[#fdf3e2] overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
    <div class="flex flex-col justify-center lg:p-16 p-6 sm:p-8 lg:p-12 text-center">
      <h2 class="font-bold leading-tight text-2xl sm:text-3xl lg:text-h2.5 mb-6 lg:mb-8 text-gray-900">
        <%= t('spree.events.pages.discover_art').html_safe %>
      </h2>
      <div class="flex justify-center">
        <button class="border-2 border-gray-800 px-6 sm:px-8 py-3 sm:py-4 text-base sm:text-lg font-medium hover:bg-gray-800 hover:text-white transition-all duration-300">
          <% if spree_user_signed_in? %>
            <%= link_to t('spree.events.pages.buy_now'), products_path %>
          <% else %>
            <%= link_to t('spree.events.pages.sign_up'), signup_path %>
          <% end %>
        </button>
      </div>
    </div>

      <div class="min-h-[40vh]" style="height: 250px; sm:height: 315px;">
      <iframe
        src="<%= youtube_embed_url(@event.youtube_url) %>"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        class="w-full h-full"
      ></iframe>
    </div>
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
