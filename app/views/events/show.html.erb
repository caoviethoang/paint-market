<section class="bg-[#f5f0e9] min-h-screen">
  <div class="mx-auto px-6 lg:px-8 py-6">
    <h1 class="text-h2.5 font-bold text-gray-900 leading-tight"><%= t('spree.events.pages.about_event') %></h1>
    
    <div class="about-event grid grid-cols-1 lg:grid-cols-3 gap-12 mt-4">
      <div class="lg:col-span-2 space-y-10">
        <div>
          <h2 class="text-h4 font-semibold text-gray-600 mb-4"><%= t('spree.events.pages.statement') %></h2>
          <p class="text-gray-700 text-lg leading-relaxed">
            <%= @event.statement.presence || "Discover an exclusive selection of silver sculptures by Salvador Dalí: refined creations including the iconic melting watches and Alice in Wonderland, where the brilliance of silver enhances the master's surrealist vision." %>
          </p>
        </div>

        <div>
          <h2 class="text-h4 font-semibold text-gray-600 mb-4"><%= t('spree.events.pages.press_release') %></h2>
          <p class="text-gray-700 text-lg leading-relaxed mb-6">
            <%= @event.press_release.presence || "Ben Brown Fine Arts is pleased to present 'Wish You Were Here', an exhibition curated by New York-based curator, art advisor, and independent scholar Jie Xia. On view at Ben Brown Fine Arts Hong Kong, the exhibition evokes the intoxicating pull of summer: the heat, the haze, and the promise of escape. Featuring works by leading postwar and contemporary artists – drawn from the gallery's programme and beyond – the exhibition explores the iconography of travel, the sea, and the rituals of seasonal escape, approached with varying degrees of meditation, longing, and nostalgia." %>
          </p>
        </div>
      </div>
      
      <div class="flex flex-col gap-10 justify-start">
        <div>
          <h2 class="text-h4 font-semibold text-gray-600 mb-4"><%= t('spree.events.pages.gallery') %></h2>
          <p class="text-gray-700 text-lg"><%= @event.gallery.presence || "Martket Gallery Ha Noi" %></p>
        </div>
        <div>
          <h2 class="text-h4 font-semibold text-gray-600 mb-4"><%= t('spree.events.pages.location') %></h2>
          <p class="text-gray-700 text-lg leading-relaxed">
            <%= @event.location.presence || "201 The Factory,<br>1 Hang Bai,<br>Ha Noi, VN.".html_safe %>
          </p>
          <p class="text-gray-700 text-lg mt-3">
            <%= @event.display_operating_hours %>
          </p>
        </div>
      </div>
    </div>

    <div class="mt-4 bg-[#fdf3e2] overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
        <div class="flex flex-col justify-center lg:p-16 p-12 text-center">
          <h2 class="font-bold font-serif leading-tight lg:text-5xl mb-8 text-gray-900 text-h2.5">
            <%= t('spree.events.pages.discover_art').html_safe %>
          </h2>
          <div class="flex justify-center">
            <button class="border-2 border-gray-800 px-8 py-4 text-lg font-medium hover:bg-gray-800 hover:text-white transition-all duration-300">
              <% if spree_user_signed_in? %>
                <%= t('spree.events.pages.buy_now') %>
              <% else %>
                <%= t('spree.events.pages.sign_up') %>
              <% end %>
            </button>
          </div>
        </div>
        
         <div class="min-h-[50vh]" style="height: 315px;">
          <iframe
            src="<%= youtube_embed_url(@event.youtube_url) %>"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="w-1/2 h-full w-full"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>



