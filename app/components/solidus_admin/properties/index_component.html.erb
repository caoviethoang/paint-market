<div class="flex flex-col gap-4">
  <!-- Header with actions -->
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">Properties</h1>
    <div class="flex gap-2">
      <%= link_to "New Property", new_admin_property_path, 
          class: "btn btn-primary" %>
    </div>
  </div>

  <!-- Search form -->
  <div class="bg-white rounded-lg border p-4">
    <%= search_form_for [:admin, search] do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :name_cont, "Name", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :name_cont, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div class="flex items-end">
          <%= f.submit "Search", class: "btn btn-primary" %>
          <%= link_to "Reset", admin_properties_path, class: "btn btn-secondary ml-2" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Properties list -->
  <div class="bg-white rounded-lg border overflow-hidden">
    <% if properties.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <input type="checkbox" id="select-all-properties" class="rounded border-gray-300">
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Name
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Values Count
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% properties.each do |property| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <input type="checkbox" class="property-checkbox rounded border-gray-300" value="<%= property.id %>">
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to property.name, admin_property_path(property), 
                      class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    <%= PropertyValue.where(property: property).count %> values
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex space-x-2">
                    <%= link_to "View", admin_property_path(property), 
                        class: "text-indigo-600 hover:text-indigo-900" %>
                    <%= link_to "Edit", edit_admin_property_path(property), 
                        class: "text-indigo-600 hover:text-indigo-900" %>
                    <%= link_to "Delete", admin_property_path(property), 
                        method: :delete, 
                        data: { confirm: "Are you sure?" },
                        class: "text-red-600 hover:text-red-900" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500">No properties found</p>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Select all functionality
  const selectAllCheckbox = document.getElementById('select-all-properties');
  const propertyCheckboxes = document.querySelectorAll('.property-checkbox');
  
  if (selectAllCheckbox) {
    selectAllCheckbox.addEventListener('change', function() {
      propertyCheckboxes.forEach(checkbox => {
        checkbox.checked = this.checked;
      });
    });
  }
  
  // Individual checkbox change
  propertyCheckboxes.forEach(checkbox => {
    checkbox.addEventListener('change', function() {
      const checkedCount = document.querySelectorAll('.property-checkbox:checked').length;
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = checkedCount === propertyCheckboxes.length;
        selectAllCheckbox.indeterminate = checkedCount > 0 && checkedCount < propertyCheckboxes.length;
      }
    });
  });
});
</script>
