<%
  title_text_classes = 'text-sm md:text-base font-medium text-gray-900'

  price_classes =
    @home_collection ?
      'text-body-xs lg:text-body lg:pb-[2px]' :
      'text-lg md:text-xl font-semibold text-gray-900'

  text_flex_classes =
    @home_collection ?
      'lg:flex justify-between items-end' :
      'flex justify-between items-end'

  padding_classes =
    @home_collection ?
      'p-3 md:p-6' :
      'p-3 md:p-4'
%>

<li
  class="w-full <%= additional_classes %>"
  itemscope
  itemtype="http://schema.org/Product"
  id="product_<%= product.id %>"
>
  <%= link_to product_path(product), itemprop: 'url' do %>
    <article class="h-full flex flex-col <%= padding_classes %> bg-white shadow-sm hover:shadow-md transition-all duration-300">
      <section class="product-card_image h-48 md:h-56 lg:h-64 w-full mb-3 md:mb-4">
        <%= render(
          ImageComponent.new(
            image: main_image,
            size: :small,
            itemprop: "image",
            classes: 'w-full h-full object-cover'
          )
        ) %>
      </section>
      <header
        class="dark:text-black mb-2 <%= text_flex_classes %>"
      >
        <section
          class="product-card_price <%= price_classes %>"
          itemprop="offers"
          itemscope
          itemtype="http://schema.org/Offer"
        >
          <% if display_price %>
             <span class="price selling" itemprop="price" content="<%= display_price.to_d %>">
            <%= display_price.to_html %>
          </span>
          <span itemprop="priceCurrency" content="<%= price_currency %>"></span>
          <% end %>
        </section>
      </header>
      <section class="product-card_header mb-2 flex-grow">
        <span class="<%= title_text_classes %>">
          <%= link_to(
            truncate(product.name, length: 70),
            product_path(product),
            class: 'hover:text-blue-600 transition-colors',
            style: 'font-weight: 700',
            itemprop: "name",
            title: product.name
          ) %>
        </span>
      </section>
      <section class="text-xs md:text-sm text-gray-600 mb-2">
        <span><%= truncate(product.description, length: 30) %></span>
      </section>
    </article>
  <% end %>
</li>
