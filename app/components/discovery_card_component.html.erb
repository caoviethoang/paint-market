<div
  class="w-full border-white last:border-none py-2"
  id="product_<%= product.id %>"
>
  <%= link_to product_path(product), itemprop: 'url', class: 'flex items-center gap-3 hover:opacity-90 transition' do %>
    <!-- Ảnh sản phẩm -->
    <div class="w-16 h-16 flex-shrink-0 overflow-hidden">
      <%= render(
        ImageComponent.new(
          image: main_image,
          size: :small,
          itemprop: "image",
          classes: 'w-full h-full object-cover'
        )
      ) %>
    </div>

    <!-- Nội dung -->
    <div class="flex flex-col justify-center items-start">
      <span class="text-sm font-semibold text-[#2a2a2a] leading-snug hover:text-[#000] transition-colors">
        <%= truncate(product.name, length: 50) %>
      </span>

      <% if display_price %>
        <span class="text-red-500 font-bold">
          <%= display_price.to_html %>
        </span>
      <% end %>
    </div>
  <% end %>
</div>

<style>
    .border-white {
      border-bottom: 1px solid white;
    }
</style>
